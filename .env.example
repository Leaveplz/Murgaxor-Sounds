PORT=3040
AUDIO_DIR=dnd music archive
ADMIN_PASSWORD=admin

# Discord bot settings.
# Create a bot in the Discord Developer Portal, copy its Bot Token here.
# Do not paste the Application Public Key from General Information.
# then restart the local server.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# Optional for YouTube anti-bot blocks.
# Set to chrome only if you agree that yt-dlp may read your local Chrome YouTube cookies.
YTDLP_COOKIES_FROM_BROWSER=
# Or export cookies to a Netscape-format txt file and point yt-dlp to it.
YTDLP_COOKIES_FILE=
