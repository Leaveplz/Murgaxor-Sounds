function init() {
    if (!configLoaded) {
        loadConfigFromServer().then(() => {
            if (!config.categories.find(c => c.id === currentCategory)) {
                currentCategory = config.categories[0]?.id || 'battle';
            }
            renderCategories();
            renderSounds();
            loadPlaylist(currentCategory);
            setupEventListeners();
            updateCounters();
            applyBackground();
            initAudioCacheUI();
            
            setTimeout(startAutoUpdate, 3000);
            
            window.addEventListener('load', function() {
                applyBackground();
            });
            
            setTimeout(function() {
                applyBackground();
            }, 300);
        });
        return;
    }
    
    if (!config.categories.find(c => c.id === currentCategory)) {
        currentCategory = config.categories[0]?.id || 'battle';
    }
    renderCategories();
    renderSounds();
    loadPlaylist(currentCategory);
    setupEventListeners();
    updateCounters();
    applyBackground();
    initAudioCacheUI();
    
    setTimeout(startAutoUpdate, 3000);
    
    window.addEventListener('load', function() {
        applyBackground();
    });
    
    setTimeout(function() {
        applyBackground();
    }, 300);
}

function applyBackground() {
    const cat = config.categories.find(c => c.id === currentCategory);
    const body = document.body;
    
    if (cat && cat.bgImage) {
        if (requestedBackgroundUrl === cat.bgImage) return;
        requestedBackgroundUrl = cat.bgImage;
        const img = new Image();
        img.decoding = 'async';
        img.fetchPriority = 'high';
        img.onload = function() {
            if (requestedBackgroundUrl !== cat.bgImage) return;
            body.style.backgroundImage = `url('${cat.bgImage}')`;
            body.style.backgroundSize = 'cover';
            body.style.backgroundPosition = 'center';
            body.style.backgroundAttachment = window.innerWidth <= 768 ? 'scroll' : 'fixed';
            body.classList.add('has-custom-bg');
        };
        img.onerror = function() {
            if (requestedBackgroundUrl !== cat.bgImage) return;
            body.style.backgroundImage = `url('${cat.bgImage}')`;
            body.style.backgroundSize = 'cover';
            body.style.backgroundPosition = 'center';
            body.style.backgroundAttachment = window.innerWidth <= 768 ? 'scroll' : 'fixed';
            body.classList.add('has-custom-bg');
        };
        img.src = cat.bgImage;
    } else {
        requestedBackgroundUrl = '';
        body.style.backgroundImage = '';
        body.style.backgroundSize = '';
        body.style.backgroundPosition = '';
        body.style.backgroundAttachment = '';
        body.classList.remove('has-custom-bg');
    }
}

