}

// ============ МУЗЫКА ============
function loadPlaylist(categoryId) {
    if (playlistCache[categoryId]) {
        currentPlaylist = playlistCache[categoryId];
        renderPlaylistUI();
        return;
    }
    
    const musicCat = config.music[categoryId] || [];
    currentPlaylist = musicCat;
    playlistCache[categoryId] = musicCat;
    currentTrackIndex = 0;
    shuffleOrder = [];
    generateShuffleOrder();
    
    renderPlaylistUI();
}

function renderPlaylistUI() {
    const musicCat = currentPlaylist;
    const playlistDiv = document.getElementById('playlistItems');
    const trackCount = document.getElementById('trackCount');
    if (trackCount) trackCount.textContent = `${musicCat.length} треков`;
    
    if (musicCat.length === 0) {
        if (playlistDiv) playlistDiv.innerHTML = '<div class="no-music"><p>Нет треков</p></div>';
        document.getElementById('trackTitle').textContent = 'Нет треков';
        document.getElementById('trackArtist').textContent = '';
        return;
    }
    
    if (playlistDiv) {
        playlistDiv.innerHTML = musicCat.map((track, i) => `
            <div class="playlist-item${i===0?' active':''}" data-index="${i}">
                <span class="playlist-num">${i+1}</span>
                <div class="playlist-item-info">
                    <div class="playlist-item-name">${escapeHtml(track.title)}</div>
                </div>
                <span class="playlist-item-duration">--:--</span>
            </div>
        `).join('');
        
        playlistDiv.querySelectorAll('.playlist-item').forEach(item => {
            item.addEventListener('click', () => playTrack(parseInt(item.dataset.index)));
            item.addEventListener('pointerenter', () => {
                const track = currentPlaylist[parseInt(item.dataset.index)];
                if (track) scheduleTrackWarmup(track.file);
            });
            item.addEventListener('focusin', () => {
                const track = currentPlaylist[parseInt(item.dataset.index)];
                if (track) scheduleTrackWarmup(track.file);
            });
        });
    }
    loadTrack(0);
}

function preloadNextTrack() {
    if (preloadTimer) {
        clearTimeout(preloadTimer);
        preloadTimer = null;
    }
    
    preloadTimer = setTimeout(() => {
        if (currentPlaylist.length > 1) {
            const nextIndex = getNextTrackIndex();
            if (nextIndex !== undefined && currentPlaylist[nextIndex]) {
                const nextTrack = currentPlaylist[nextIndex];
                if (musicAudio.src !== new URL(nextTrack.file, window.location.href).href) {
                    let preloadAudio = new Audio();
                    preloadAudio.preload = 'metadata';
                    setCacheFirstAudioSource(preloadAudio, nextTrack.file).then(() => {
                        preloadAudio.load();
                        musicPreloaded = true;
                        setTimeout(() => {
                            preloadAudio.removeAttribute('src');
                            preloadAudio = null;
                        }, 5000);
                    });
                }
            }
        }
        preloadTimer = null;
    }, 2000);
}

function generateShuffleOrder() {
    shuffleOrder = Array.from({length: currentPlaylist.length}, (_, i) => i);
    if (shuffleMode) {
        for (let i = shuffleOrder.length-1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i+1));
            [shuffleOrder[i], shuffleOrder[j]] = [shuffleOrder[j], shuffleOrder[i]];
        }
    }
}

function getNextTrackIndex() {
    if (shuffleMode) {
        const idx = shuffleOrder.indexOf(currentTrackIndex);
        return idx < shuffleOrder.length-1 ? shuffleOrder[idx+1] : (generateShuffleOrder(), shuffleOrder[0]);
    }
    return (currentTrackIndex + 1) % currentPlaylist.length;
}

function getPrevTrackIndex() {
    if (shuffleMode) {
        const idx = shuffleOrder.indexOf(currentTrackIndex);
        return idx > 0 ? shuffleOrder[idx-1] : shuffleOrder[shuffleOrder.length-1];
    }
    return currentTrackIndex - 1 < 0 ? currentPlaylist.length - 1 : currentTrackIndex - 1;
}

function loadTrack(index) {
    if (currentPlaylist.length === 0) return;
    currentTrackIndex = index;
    const track = currentPlaylist[index];
    selectedMusicFile = track.file;
    musicAudio.volume = musicVolume;
    // Не назначаем src и не вызываем load() при открытии страницы или смене
    // категории. Иначе браузер делает Range-запрос к MP3, хотя пользователь
    // музыку ещё не запускал. Источник подключится непосредственно перед play().
    if (!musicPlaying) {
        musicAudio.pause();
        musicAudio.removeAttribute('src');
    }
    document.getElementById('trackTitle').textContent = track.title;
    document.getElementById('trackArtist').textContent = (config.categories.find(c => c.id === currentCategory) || {}).name || '';
    updatePlaylistHighlight();
    const pf = document.getElementById('progressFill');
    const ct = document.getElementById('currentTime');
    const tt = document.getElementById('totalTime');
    if (pf) pf.style.width = '0%';
    if (ct) ct.textContent = '0:00';
    if (tt) tt.textContent = '--:--';

    // Предзагружаем следующий трек только если музыка реально играет —
    // иначе при обычном открытии страницы браузер тянет треки, которые никто не запускал
    if (musicPlaying) preloadNextTrack();
}

// Подготовка метаданных при осознанном наведении на трек. Небольшая задержка
// не даёт создавать десятки запросов, когда курсор быстро проходит по списку.
function scheduleTrackWarmup(file) {
    if (!file || musicPlaying) return;
    if (hoverPreloadTimer) clearTimeout(hoverPreloadTimer);
    hoverPreloadTimer = setTimeout(() => {
        if (hoverPreloadAudio) {
            hoverPreloadAudio.pause();
            hoverPreloadAudio.removeAttribute('src');
        }
        hoverPreloadAudio = new Audio();
        hoverPreloadAudio.preload = 'metadata';
        hoverPreloadAudio.src = file;
        hoverPreloadAudio.load();
    }, 180);
}

async function ensureSelectedMusicSource() {
    if (!selectedMusicFile) return false;
    return setCacheFirstAudioSource(musicAudio, selectedMusicFile);
}

async function playTrack(index) {
    if (currentPlaylist.length === 0) return;
    if (index === currentTrackIndex && musicPlaying) {
        musicAudio.pause();
        musicPlaying = false;
        updateMusicButton();
        updatePlaylistHighlight();
        return;
    }
    if (index !== currentTrackIndex) loadTrack(index);
    if (!await ensureSelectedMusicSource()) return;
    musicAudio.play().then(() => {
        musicPlaying = true;
        updateMusicButton();
        updatePlaylistHighlight();
        preloadNextTrack();
    }).catch(err => {
        console.error(err);
    });
}

async function playNextTrack() {
    if (currentPlaylist.length === 0) return;
    loadTrack(getNextTrackIndex());
    if (musicPlaying && await ensureSelectedMusicSource()) musicAudio.play().catch(() => {});
}

async function playPrevTrack() {
    if (currentPlaylist.length === 0) return;
    loadTrack(getPrevTrackIndex());
    if (musicPlaying && await ensureSelectedMusicSource()) musicAudio.play().catch(() => {});
}

function toggleShuffle() {
    shuffleMode = !shuffleMode;
    const btn = document.getElementById('shuffleBtn');
    if (btn) {
        if (shuffleMode) {
            btn.classList.add('active');
            generateShuffleOrder();
        } else {
            btn.classList.remove('active');
        }
    }
}

function toggleRepeat() {
    repeatMode = !repeatMode;
    const btn = document.getElementById('repeatBtn');
    if (btn) {
        if (repeatMode) btn.classList.add('active');
        else btn.classList.remove('active');
    }
}

function updateMusicButton() {
    const pi = document.getElementById('playIcon');
    const pa = document.getElementById('pauseIcon');
    if (pi && pa) {
        if (musicPlaying) {
            pi.style.display = 'none';
            pa.style.display = 'block';
        } else {
            pi.style.display = 'block';
            pa.style.display = 'none';
        }
    }
}

function updatePlaylistHighlight() {
    document.querySelectorAll('.playlist-item').forEach((item, i) => {
        item.classList.toggle('active', i === currentTrackIndex);
        item.classList.toggle('playing', i === currentTrackIndex && musicPlaying);
    });
}

function setupEventListeners() {
    document.getElementById('musicPlayBtn').addEventListener('click', () => playTrack(currentTrackIndex));
    document.getElementById('prevBtn').addEventListener('click', playPrevTrack);
    document.getElementById('nextBtn').addEventListener('click', playNextTrack);
    document.getElementById('shuffleBtn').addEventListener('click', toggleShuffle);
    document.getElementById('repeatBtn').addEventListener('click', toggleRepeat);
    
    document.getElementById('progressBar').addEventListener('click', function(e) {
        const r = this.getBoundingClientRect();
        if (musicAudio.duration) {
            musicAudio.currentTime = ((e.clientX - r.left) / r.width) * musicAudio.duration;
        }
    });
    
    musicAudio.addEventListener('timeupdate', () => {
        if (musicAudio.duration) {
            const pf = document.getElementById('progressFill');
            const ct = document.getElementById('currentTime');
            if (pf) pf.style.width = (musicAudio.currentTime / musicAudio.duration * 100) + '%';
            if (ct) ct.textContent = formatTime(musicAudio.currentTime);
            updateTrackDuration(currentTrackIndex, formatTime(musicAudio.duration));
        }
    });
    
    musicAudio.addEventListener('loadedmetadata', () => {
        const tt = document.getElementById('totalTime');
        if (tt) tt.textContent = formatTime(musicAudio.duration);
        updateTrackDuration(currentTrackIndex, formatTime(musicAudio.duration));
    });
    
    musicAudio.addEventListener('ended', () => {
        if (repeatMode) {
            musicAudio.currentTime = 0;
            musicAudio.play();
        } else {
            playNextTrack();
        }
    });
    
    const musicVol = document.getElementById('musicVolume');
    if (musicVol) {
        musicVol.addEventListener('input', function(e) {
            musicVolume = e.target.value / 100;
            musicAudio.volume = musicVolume;
            const mvv = document.getElementById('musicVolumeValue');
            if (mvv) mvv.textContent = e.target.value + '%';
            this.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${e.target.value}%, rgba(255,255,255,0.15) ${e.target.value}%, rgba(255,255,255,0.15) 100%)`;
        });
        
        try {
            const saved = sessionStorage.getItem('dragonSound_user_settings');
            if (saved) {
                const settings = JSON.parse(saved);
                if (settings && settings.music_volume !== undefined) {
                    musicVol.value = settings.music_volume;
                    const mvv = document.getElementById('musicVolumeValue');
                    if (mvv) mvv.textContent = settings.music_volume + '%';
                    musicVol.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${settings.music_volume}%, rgba(255,255,255,0.15) ${settings.music_volume}%, rgba(255,255,255,0.15) 100%)`;
                    musicVolume = settings.music_volume / 100;
                    musicAudio.volume = musicVolume;
                }
            }
        } catch (e) {}
    }
}

function updateTrackDuration(index, duration) {
    const items = document.querySelectorAll('.playlist-item-duration');
    if (items[index]) items[index].textContent = duration;
}

function formatTime(s) {
    if (isNaN(s)) return '--:--';
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m}:${sec.toString().padStart(2, '0')}`;
}

