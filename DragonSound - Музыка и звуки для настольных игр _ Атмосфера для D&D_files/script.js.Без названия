function generateAvailableKeys() {
    const keys = [];
    for (let i = 0; i <= 9; i++) keys.push(String(i));
    for (let i = 65; i <= 90; i++) keys.push(String.fromCharCode(i).toLowerCase());
    const specialKeys = [
        '`', '-', '=', '[', ']', '\\', ';', "'", ',', '.', '/',
        '!', '@', '#', '$', '%', '^', '&', '*', '(', ')', '_', '+',
        '{', '}', '|', ':', '"', '<', '>', '?',
        'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10', 'F11', 'F12',
        'Insert', 'Home', 'PageUp', 'PageDown', 'End', 'Delete'
    ];
    keys.push(...specialKeys);
    return keys;
}

