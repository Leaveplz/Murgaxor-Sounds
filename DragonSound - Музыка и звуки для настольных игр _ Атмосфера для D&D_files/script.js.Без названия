function observeLazyImages(root = document) {
    const images = root.querySelectorAll('img[data-src]:not([data-lazy-ready])');
    if (!('IntersectionObserver' in window)) {
        images.forEach(img => { img.src = img.dataset.src; img.dataset.lazyReady = 'true'; });
        return;
    }
    if (!lazyImageObserver) {
        lazyImageObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (!entry.isIntersecting) return;
                const img = entry.target;
                img.src = img.dataset.src;
                img.dataset.lazyReady = 'true';
                img.removeAttribute('data-src');
                observer.unobserve(img);
            });
        }, { rootMargin: '350px 0px', threshold: 0.01 });
    }
    images.forEach(img => lazyImageObserver.observe(img));
}

