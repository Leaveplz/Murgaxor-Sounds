    section.style.display = count > 0 ? '' : 'none';
    const countEl = document.getElementById('favoritesCount');
    if (countEl) countEl.textContent = `(${count})`;
}

// Карточка в «Избранном» остаётся связана с исходной категорией. Поэтому
// режим повтора всегда заново берём из config, а не из положения карточки в DOM.
function syncSoundRepeatProperty(soundId) {
    const data = audioObjects[soundId];
    if (!data) return true;
    const sourceCategory = data.categoryKey && config?.sounds ? config.sounds[data.categoryKey] : null;
    const shouldLoop = sourceCategory && sourceCategory.loop !== undefined
        ? Boolean(sourceCategory.loop)
        : (data.loop !== undefined ? Boolean(data.loop) : true);
    data.loop = shouldLoop;
    if (data.audio) data.audio.loop = shouldLoop;

    const card = document.getElementById(`card-${soundId}`);
    if (card) {
        card.dataset.loop = shouldLoop ? 'true' : 'false';
        const badge = card.querySelector('.sound-card-loop-badge');
        if (badge) {
            badge.textContent = shouldLoop ? '↻' : '1×';
            badge.title = shouldLoop ? 'Автоповтор включён' : 'Однократное воспроизведение';
        }
    }
    return shouldLoop;
}

// Не клонируем карточку, а физически переносим её DOM-узел между секциями —
// так у играющего звука не сбрасывается audioObjects/Audio-элемент, и не
// возникает дублей id="card-..." на странице.
function toggleFavorite(soundId) {
    if (!isLoggedIn()) {
        showAuthRequiredModal('Чтобы сохранять звуки в избранное, нужно зарегистрироваться — так они не потеряются и будут доступны с любого устройства.');
        return;
    }

    const card = document.getElementById(`card-${soundId}`);
    const idx = favorites.indexOf(soundId);
    const favSection = document.getElementById('favoritesSection');
    const favGrid = favSection ? favSection.querySelector('.sound-grid') : null;

    if (idx === -1) {
        favorites.push(soundId);
        syncSoundRepeatProperty(soundId);
        if (card && favGrid) favGrid.appendChild(card);
    } else {
        favorites.splice(idx, 1);
        const home = favoriteCardHomes[soundId];
        if (card && home && home.parent) home.parent.appendChild(card);
    }

    const favBtn = card ? card.querySelector('.sound-card-fav-btn') : null;
    if (favBtn) {
        const nowFav = favorites.includes(soundId);
        favBtn.classList.toggle('active', nowFav);
        favBtn.textContent = nowFav ? '★' : '☆';
        favBtn.title = nowFav ? 'Убрать из избранного' : 'В избранное';
    }

    saveFavoritesSession();
    updateFavoritesSectionVisibility();
}

function lazyLoadSounds() {
    const cards = document.querySelectorAll('.sound-card:not(.loaded)');
    if (cards.length === 0) return;
    
    if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const card = entry.target;
                    const soundId = card.id.replace('card-', '');
                    if (audioObjects[soundId] && !audioObjects[soundId].loaded) {
                        const audio = new Audio();
                        audio.loop = audioObjects[soundId].loop !== undefined ? audioObjects[soundId].loop : true;
                        audio.volume = audioObjects[soundId].volume / 100;
                        audio.preload = 'none';
                        audioObjects[soundId].audio = audio;
                        audioObjects[soundId].loaded = true;
                        card.classList.add('loaded');
                        
                        audio.addEventListener('ended', function() {
                            const data = audioObjects[soundId];
                            if (data) {
                                data.playing = false;
                                const cardEl = document.getElementById(`card-${soundId}`);
                                const btnEl = document.getElementById(`btn-${soundId}`);
                                if (cardEl) cardEl.classList.remove('playing');
                                if (btnEl) btnEl.textContent = '▶';
                                updateCounters();
                                updatePauseButton();
                            }
                        });
                    }
                    observer.unobserve(card);
                }
            });
        }, { rootMargin: '200px' });
        
        cards.forEach(card => observer.observe(card));
    } else {
        cards.forEach(card => {
            const soundId = card.id.replace('card-', '');
            if (audioObjects[soundId] && !audioObjects[soundId].loaded) {
                const audio = new Audio();
                audio.loop = audioObjects[soundId].loop !== undefined ? audioObjects[soundId].loop : true;
                audio.volume = audioObjects[soundId].volume / 100;
                audio.preload = 'none';
                audioObjects[soundId].audio = audio;
                audioObjects[soundId].loaded = true;
                card.classList.add('loaded');
                
                audio.addEventListener('ended', function() {
                    const data = audioObjects[soundId];
                    if (data) {
                        data.playing = false;
                        const cardEl = document.getElementById(`card-${soundId}`);
                        const btnEl = document.getElementById(`btn-${soundId}`);
                        if (cardEl) cardEl.classList.remove('playing');
                        if (btnEl) btnEl.textContent = '▶';
                        updateCounters();
                        updatePauseButton();
                    }
                });
            }
        });
    }
}

async function refreshConfigCacheInBackground() {
    try {
        const response = await fetch('config_sync.php', { cache: 'no-store' });
        if (!response.ok) return;
        const fresh = await response.json();
        if (!fresh || !fresh.categories || !fresh.sounds || !fresh.music) return;

        localStorage.setItem('dragonSound_config', JSON.stringify(fresh));
        const changed = JSON.stringify(fresh) !== JSON.stringify(config);
        if (!changed) return;

        if (!initialRenderComplete) {
            config = fresh;
        } else {
            window._pendingConfig = fresh;
            showUpdateNotificationWithButton();
        }
    } catch (e) {
        console.log('⚠️ Фоновое обновление конфига недоступно');
    }
}

// Начинаем подготавливать звук, когда пользователь навёл мышь или дошёл до
// кнопки клавиатурой. Это даёт браузеру фору до клика, но не запускает загрузку
// всех 50+ файлов при открытии страницы.
async function prepareSoundForPlayback(soundId) {
    const data = audioObjects[soundId];
    if (!data || !data.file) return;
    syncSoundRepeatProperty(soundId);

    if (!data.audio) {
        data.audio = new Audio();
        data.audio.loop = data.loop !== undefined ? data.loop : true;
        data.audio.volume = data.volume / 100;
    }

    await setCacheFirstAudioSource(data.audio, data.file);

    if (data.audio.preload !== 'metadata') {
        data.audio.preload = 'metadata';
        data.audio.load();
    }
    data.loaded = true;
}

async function toggleSound(soundId) {
    const data = audioObjects[soundId];
    if (!data) return;
    syncSoundRepeatProperty(soundId);
    
    const card = document.getElementById(`card-${soundId}`);
    const btn = document.getElementById(`btn-${soundId}`);
    
    function createAudioWithEndHandler() {
        const audio = new Audio();
        audio.loop = data.loop !== undefined ? data.loop : true;
        audio.volume = data.volume / 100;
        audio.preload = 'metadata';
        
        audio.addEventListener('ended', function() {
            if (!data.loop) {
                data.playing = false;
                if (card) card.classList.remove('playing');
                if (btn) btn.textContent = '▶';
                updateCounters();
                updatePauseButton();
            }
        });
        
        return audio;
    }
    
    if (!data.loaded) {
        data.audio = createAudioWithEndHandler();
        data.loaded = true;
    }
    
    if (data.playing) {
        if (data.audio) {
            data.audio.pause();
            data.audio.currentTime = 0;
        }
        data.playing = false;
        if (card) card.classList.remove('playing');
        if (btn) btn.textContent = '▶';
    } else {
        if (!data.audio) {
            data.audio = createAudioWithEndHandler();
            data.loaded = true;
        }

        await setCacheFirstAudioSource(data.audio, data.file);
        
        if (!data.loop && data.audio) {
            data.audio.currentTime = 0;
        }
        
        data.audio.play().then(() => {
            data.playing = true;
            if (card) card.classList.add('playing');
            if (btn) btn.textContent = '⏸';
            updateCounters();
        }).catch(err => {
            console.error('Ошибка воспроизведения:', err);
            data.playing = false;
            if (card) card.classList.remove('playing');
            if (btn) btn.textContent = '▶';
            updateCounters();
        });
    }
    soundsPaused = false;
    updatePauseButton();
    updateCounters();
}

function changeVolume(soundId, value) {
    const data = audioObjects[soundId];
    if (!data) return;
    const vol = value / 100;
    data.volume = parseInt(value);
    if (data.audio) data.audio.volume = vol;
    
    const display = document.getElementById(`val-${soundId}`);
    if (display) display.textContent = value + '%';
    
    const slider = document.getElementById(`vol-${soundId}`);
    if (slider) {
        const percent = value;
        slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${percent}%, rgba(255,255,255,0.15) ${percent}%, rgba(255,255,255,0.15) 100%)`;
    }
}

function saveAllSoundVolumes() {
    const volumes = {};
    for (let soundId in audioObjects) {
        if (audioObjects[soundId] && typeof audioObjects[soundId].volume === 'number' && !isNaN(audioObjects[soundId].volume)) {
            volumes[soundId] = Math.min(100, Math.max(0, audioObjects[soundId].volume));
        } else {
            volumes[soundId] = 50;
        }
    }
    
    const cleanVolumes = {};
    for (let key in volumes) {
        if (typeof volumes[key] === 'number' && !isNaN(volumes[key]) && volumes[key] >= 0 && volumes[key] <= 100) {
            cleanVolumes[key] = volumes[key];
        } else {
            cleanVolumes[key] = 50;
        }
    }
    
    try {
        sessionStorage.setItem('dragonSound_soundVolumes', JSON.stringify(cleanVolumes));
    } catch (e) {
        console.error('❌ Ошибка сохранения громкостей в сессии:', e);
    }
}

function loadSoundVolumes() {
    if (userSettings && userSettings.soundVolumes) {
        let appliedCount = 0;
        for (let soundId in userSettings.soundVolumes) {
            if (audioObjects[soundId]) {
                const vol = typeof userSettings.soundVolumes[soundId] === 'number' ? userSettings.soundVolumes[soundId] : 50;
                audioObjects[soundId].volume = Math.min(100, Math.max(0, vol));
                if (audioObjects[soundId].audio) {
                    audioObjects[soundId].audio.volume = audioObjects[soundId].volume / 100;
                }
                const slider = document.getElementById(`vol-${soundId}`);
                const display = document.getElementById(`val-${soundId}`);
                if (slider) {
                    slider.value = audioObjects[soundId].volume;
                    const percent = audioObjects[soundId].volume;
                    slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${percent}%, rgba(255,255,255,0.15) ${percent}%, rgba(255,255,255,0.15) 100%)`;
                }
                if (display) display.textContent = audioObjects[soundId].volume + '%';
                appliedCount++;
            }
        }
        return;
    }
    
    try {
        const saved = sessionStorage.getItem('dragonSound_soundVolumes');
        if (saved) {
            const volumes = JSON.parse(saved);
            if (Array.isArray(volumes)) {
                const obj = {};
                for (let i = 0; i < volumes.length; i++) {
                    obj[i] = volumes[i];
                }
                sessionStorage.setItem('dragonSound_soundVolumes', JSON.stringify(obj));
                return;
            }
            
            let appliedCount = 0;
            for (let soundId in volumes) {
                if (audioObjects[soundId]) {
                    const vol = typeof volumes[soundId] === 'number' ? Math.min(100, Math.max(0, volumes[soundId])) : 50;
                    audioObjects[soundId].volume = vol;
                    if (audioObjects[soundId].audio) {
                        audioObjects[soundId].audio.volume = vol / 100;
                    }
                    const slider = document.getElementById(`vol-${soundId}`);
                    const display = document.getElementById(`val-${soundId}`);
                    if (slider) {
                        slider.value = vol;
                        const percent = vol;
                        slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${percent}%, rgba(255,255,255,0.15) ${percent}%, rgba(255,255,255,0.15) 100%)`;
                    }
                    if (display) display.textContent = vol + '%';
                    appliedCount++;
                }
            }
        }
    } catch (e) {
        console.error('❌ Ошибка загрузки громкостей:', e);
        try {
            sessionStorage.removeItem('dragonSound_soundVolumes');
        } catch (err) {}
    }
}

function pauseAllSounds() {
    pauseAllSoundsAndMusic();
}

function stopAllSounds() {
    stopAllSoundsAndMusic();
}

// Смена категории меняет плейлист музыки, что и так обрывает старый трек через
// musicAudio.load() внутри loadTrack() — но без этого состояние musicPlaying
// и иконка play/pause оставались рассинхронизированы (звук уже не играет,
// а кнопка всё ещё показывает "пауза"). Явно ставим на паузу и синхронизируем UI.
function pauseMusicOnSwitch() {
    if (musicPlaying) {
        musicAudio.pause();
        musicPlaying = false;
        updateMusicButton();
        updatePlaylistHighlight();
    }
}

function pauseAllSoundsAndMusic() {
    if (musicPlaying) {
        musicAudio.pause();
        musicPlaying = false;
        updateMusicButton();
        updatePlaylistHighlight();
    }
    
    const hasActive = Object.values(audioObjects).some(d => d.playing);
    
    const hasExternalMusic = typeof activeMusicSource !== 'undefined' && activeMusicSource !== 'local';
    if (!hasActive && !soundsPaused && !hasExternalMusic) {
        showKeyBindingNotification('⏸ Нет активных звуков');
        return;
    }
    
    if (soundsPaused) {
        resumeAllSounds();
        if (activeMusicSource === 'local' && !musicPlaying && musicAudio.src) {
            musicAudio.play().then(() => {
                musicPlaying = true;
                updateMusicButton();
                updatePlaylistHighlight();
            }).catch(err => console.error(err));
        }
        showKeyBindingNotification('▶ Продолжить');
        return;
    }
    
    pausedSounds = [];
    Object.entries(audioObjects).forEach(([id, data]) => {
        if (data.playing && data.audio) {
            data.audio.pause();
            data.playing = false;
            pausedSounds.push(id);
            const card = document.getElementById(`card-${id}`);
            const btn = document.getElementById(`btn-${id}`);
            if (card) { card.classList.remove('playing'); card.classList.add('paused'); }
            if (btn) btn.textContent = '⏸';
        }
    });
    soundsPaused = true;
    updatePauseButton();
    updateCounters();
    showKeyBindingNotification('⏸ Пауза');
}

function stopAllSoundsAndMusic() {
    if (musicAudio) {
        musicAudio.pause();
        musicAudio.currentTime = 0;
        musicPlaying = false;
        updateMusicButton();
        updatePlaylistHighlight();
        const pf = document.getElementById('progressFill');
        const ct = document.getElementById('currentTime');
        const tt = document.getElementById('totalTime');
        if (pf) pf.style.width = '0%';
        if (ct) ct.textContent = '0:00';
        if (tt) tt.textContent = '--:--';
    }
    
    Object.entries(audioObjects).forEach(([id, data]) => {
        if (data.audio) {
            data.audio.pause();
            data.audio.currentTime = 0;
        }
        data.playing = false;
        
        const card = document.getElementById(`card-${id}`);
        const btn = document.getElementById(`btn-${id}`);
        
        if (card) { 
            card.classList.remove('playing'); 
            card.classList.remove('paused'); 
        }
        if (btn) btn.textContent = '▶';
    });
    
    pausedSounds = [];
    soundsPaused = false;
    updatePauseButton();
    updateCounters();
    
    showKeyBindingNotification('⏹ Всё остановлено');
}

function resumeAllSounds() {
    Promise.all(pausedSounds.map(id => {
        const data = audioObjects[id];
        if (data && data.audio) {
            if (!data.loop) {
                data.audio.currentTime = 0;
            }
            return data.audio.play().then(() => {
                data.playing = true;
                const card = document.getElementById(`card-${id}`);
                const btn = document.getElementById(`btn-${id}`);
                if (card) { card.classList.remove('paused'); card.classList.add('playing'); }
                if (btn) btn.textContent = '⏸';
            }).catch(err => console.error(err));
        }
        return Promise.resolve();
    })).then(() => {
        pausedSounds = [];
        soundsPaused = false;
        updatePauseButton();
        updateCounters();
    });
}

function updatePauseButton() {
    const btn = document.getElementById('pauseAllBtn');
    const mobileBtn = document.getElementById('mobilePauseBtn');
    
    const activeCount = Object.values(audioObjects).filter(d => d.playing).length;
    
    // Обновляем обычную кнопку
    if (btn) {
        if (activeCount === 0 && !soundsPaused) {
            btn.textContent = '⏸ Пауза';
        } else {
            btn.textContent = soundsPaused ? '▶ Продолжить' : '⏸ Пауза';
        }
    }
    
    // Обновляем мобильную кнопку (SVG)
    if (mobileBtn) {
        mobileBtn.classList.remove('resume', 'has-active');
        
        if (activeCount > 0) {
            mobileBtn.classList.add('has-active');
        }
        
        if (soundsPaused && activeCount > 0) {
            mobileBtn.classList.add('resume');
            mobileBtn.title = 'Продолжить';
            mobileBtn.innerHTML = `
                <svg viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
            `;
        } else {
            mobileBtn.title = activeCount > 0 ? 'Пауза' : 'Нет активных звуков';
            mobileBtn.innerHTML = `
                <svg viewBox="0 0 24 24">
                    <rect x="6" y="4" width="4" height="16"/>
                    <rect x="14" y="4" width="4" height="16"/>
                </svg>
            `;
        }
    }
}

function updateCounters() {
    let count = 0;
    for (let id in audioObjects) {
        if (audioObjects[id].playing === true) count++;
    }
    
    // Обновляем обычные счётчики
    const ac = document.getElementById('activeCount');
    const ach = document.getElementById('activeCountHeader');
    if (ac) ac.textContent = count;
    if (ach) ach.textContent = count;
    
    // ===== ОБНОВЛЯЕМ МОБИЛЬНЫЙ БЕЙДЖ =====
    const mobileBadge = document.getElementById('mobileActiveCount');
    if (mobileBadge) {
        mobileBadge.textContent = count;
        if (count > 0) {
            mobileBadge.classList.add('has-active');
            mobileBadge.classList.add('pulsing');
        } else {
