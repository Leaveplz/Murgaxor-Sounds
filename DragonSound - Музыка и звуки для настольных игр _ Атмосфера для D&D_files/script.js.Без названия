const rusToEngMap = {
    'й': 'q', 'ц': 'w', 'у': 'e', 'к': 'r', 'е': 't', 'н': 'y', 'г': 'u', 'ш': 'i', 'щ': 'o', 'з': 'p', 'х': '[', 'ъ': ']',
    'ф': 'a', 'ы': 's', 'в': 'd', 'а': 'f', 'п': 'g', 'р': 'h', 'о': 'j', 'л': 'k', 'д': 'l', 'ж': ';', 'э': "'",
    'я': 'z', 'ч': 'x', 'с': 'c', 'м': 'v', 'и': 'b', 'т': 'n', 'ь': 'm', 'б': ',', 'ю': '.', 'ё': '`',
    'Й': 'Q', 'Ц': 'W', 'У': 'E', 'К': 'R', 'Е': 'T', 'Н': 'Y', 'Г': 'U', 'Ш': 'I', 'Щ': 'O', 'З': 'P', 'Х': '[', 'Ъ': ']',
    'Ф': 'A', 'Ы': 'S', 'В': 'D', 'А': 'F', 'П': 'G', 'Р': 'H', 'О': 'J', 'Л': 'K', 'Д': 'L', 'Ж': ';', 'Э': "'",
    'Я': 'Z', 'Ч': 'X', 'С': 'C', 'М': 'V', 'И': 'B', 'Т': 'N', 'Ь': 'M', 'Б': ',', 'Ю': '.', 'Ё': '`'
};

function normalizeRusKey(key) {
    if (rusToEngMap[key]) {
        return rusToEngMap[key];
    }
    return key;
}

function getKeyDisplayName(key) {
    const normalized = normalizeRusKey(key);
    const map = {
        '↑': '↑', '↓': '↓', '←': '←', '→': '→',
        'ArrowUp': '↑', 'ArrowDown': '↓', 'ArrowLeft': '←', 'ArrowRight': '→',
        'home': 'Home', 'end': 'End', 'pageup': 'PageUp', 'pagedown': 'PageDown',
        'insert': 'Insert', 'delete': 'Delete', 'backspace': '⌫', 'tab': 'Tab',
        'capslock': 'Caps', 'shift': 'Shift', 'ctrl': 'Ctrl', 'alt': 'Alt', 'meta': 'Meta'
    };
    if (normalized && normalized.startsWith('F') && normalized.length <= 3 && /^F[1-9][0-2]?$/.test(normalized)) {
        return normalized;
    }
    if (normalized && /^[a-zA-Z0-9]$/.test(normalized)) {
        return normalized.toUpperCase();
    }
    if (normalized === 'esc') return 'Esc';
    if (normalized === 'space') return 'Пробел';
    return map[normalized] || normalized;
}

function isKeyAllowed(key) {
    const engKey = normalizeRusKey(key);
    if (/^[a-zA-Z]$/.test(engKey)) return true;
    if (/^[0-9]$/.test(engKey)) return true;
    if (['↑', '↓', '←', '→'].includes(engKey)) return true;
    if (engKey && engKey.startsWith('F') && engKey.length <= 3 && /^F[1-9][0-2]?$/.test(engKey)) return true;
    return false;
}

function normalizeKey(key) {
    const normalized = normalizeRusKey(key);
    if (normalized === ' ' || normalized === 'space') return 'space';
    if (normalized === 'Escape' || normalized === 'esc') return 'esc';
    if (normalized === 'Enter' || normalized === 'enter') return 'enter';
    if (normalized === 'Backspace' || normalized === 'backspace') return 'backspace';
    if (normalized === 'Tab' || normalized === 'tab') return 'tab';
    if (normalized === 'CapsLock' || normalized === 'capslock') return 'capslock';
    if (normalized === 'Shift' || normalized === 'shift') return 'shift';
    if (normalized === 'Control' || normalized === 'ctrl') return 'ctrl';
    if (normalized === 'Alt' || normalized === 'alt') return 'alt';
    if (normalized === 'Meta' || normalized === 'meta') return 'meta';
    if (normalized === 'ArrowUp') return '↑';
    if (normalized === 'ArrowDown') return '↓';
    if (normalized === 'ArrowLeft') return '←';
    if (normalized === 'ArrowRight') return '→';
    if (normalized === 'Home') return 'home';
    if (normalized === 'End') return 'end';
    if (normalized === 'PageUp') return 'pageup';
    if (normalized === 'PageDown') return 'pagedown';
    if (normalized === 'Insert') return 'insert';
    if (normalized === 'Delete') return 'delete';
    if (normalized.startsWith('F') && normalized.length <= 3) return normalized;
    return normalized;
}

// ============ ГЛОБАЛЬНАЯ БЛОКИРОВКА СТАНДАРТНЫХ КЛАВИШ ============
document.addEventListener('keydown', function(e) {
    const blockedKeys = [
        ' ', 'Space', 'Tab', 'Enter', 'Escape',
        'Home', 'End', 'PageUp', 'PageDown',
        'Insert', 'Delete', 'Backspace',
        'CapsLock', 'Shift', 'Control', 'Alt', 'Meta',
        '`', '-', '=', '[', ']', '\\', ';', "'", ',', '.', '/',
        '!', '@', '#', '$', '%', '^', '&', '*', '(', ')', '_', '+',
        '{', '}', '|', ':', '"', '<', '>', '?'
    ];
    
    if (blockedKeys.includes(e.key)) {
        if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA' && e.target.tagName !== 'SELECT') {
            e.preventDefault();
            e.stopPropagation();
        }
    }
}, true);

// ============ ЗАГРУЗКА КОНФИГУРАЦИИ ============
async function loadConfigFromServer() {
    // На повторных визитах сразу используем последнюю рабочую копию. Серверную
    // версию проверяем параллельно, поэтому интерфейс не ждёт PHP-хостинг.
    try {
        const saved = localStorage.getItem('dragonSound_config');
        if (saved) {
            const cached = JSON.parse(saved);
            if (cached && cached.categories && cached.sounds && cached.music) {
                config = cached;
                configLoaded = true;
                refreshConfigCacheInBackground();
                console.log('✅ Конфигурация мгновенно загружена из кэша');
                return true;
            }
        }
    } catch (e) {
        localStorage.removeItem('dragonSound_config');
    }

    try {
        const response = await fetch('config_sync.php');
        if (response.ok) {
            const data = await response.json();
            if (data && data.categories) {
                config = data;
                configLoaded = true;
                localStorage.setItem('dragonSound_config', JSON.stringify(data));
                console.log('✅ Конфигурация загружена с сервера');
                return true;
            }
        }
    } catch (e) {
        console.log('⚠️ Не удалось загрузить конфиг с сервера:', e);
    }
    
    try {
        if (typeof defaultConfig !== 'undefined') {
            config = JSON.parse(JSON.stringify(defaultConfig));
            configLoaded = true;
            console.log('✅ Используется defaultConfig из config.js');
            return true;
        }
    } catch (e) {}
    
    config = {
        adminLogin: 'admin',
        adminPassword: 'dragon2024',
        categories: [],
        sounds: {},
        music: {}
    };
    configLoaded = true;
    return true;
}

