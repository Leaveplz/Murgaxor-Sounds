        img.src = settings.avatar;
        img.alt = 'Аватар';
        img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block;border-radius:50%;';
        img.onerror = function() {
            headerAvatar.textContent = '👤';
            headerAvatar.style.cssText = '';
