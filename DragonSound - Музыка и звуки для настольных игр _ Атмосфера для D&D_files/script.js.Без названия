    clearTimeout(notification._timeout);
    notification._timeout = setTimeout(() => {
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(-50%) translateY(20px)';
    }, 4000);
}

function handleKeyPress(e) {
    // === РЕЖИМ НАЗНАЧЕНИЯ КЛАВИШ ===
    if (keyBindingMode) {
        e.preventDefault();
        e.stopPropagation();
        let key = e.key;
        if (key === ' ') key = 'space';
        
        if (key === 'Escape') {
            keyBindingMode = false;
            if (bindingTarget) {
                const card = document.getElementById(`card-${bindingTarget}`);
                if (card) {
                    card.style.boxShadow = '';
                    card.style.borderColor = '';
                    card.style.borderColor = '#e74c3c';
                    card.style.boxShadow = '0 0 20px rgba(231, 76, 60, 0.3)';
                    setTimeout(() => {
                        card.style.borderColor = '';
                        card.style.boxShadow = '';
                    }, 800);
                }
                bindingTarget = null;
            }
            showKeyBindingNotification('❌ Назначение отменено (Esc)');
            renderKeyBindingsUI();
            return;
        }
        
        let normalizedKey = key;
        if (key === ' ') normalizedKey = 'space';
        else if (key === 'Escape') normalizedKey = 'esc';
        else if (key === 'Enter') normalizedKey = 'enter';
        else if (key === 'Backspace') normalizedKey = 'backspace';
        else if (key === 'Tab') normalizedKey = 'tab';
        else if (key === 'CapsLock') normalizedKey = 'capslock';
        else if (key === 'Shift') normalizedKey = 'shift';
        else if (key === 'Control') normalizedKey = 'ctrl';
        else if (key === 'Alt') normalizedKey = 'alt';
        else if (key === 'Meta') normalizedKey = 'meta';
        else if (key === 'ArrowUp') normalizedKey = '↑';
        else if (key === 'ArrowDown') normalizedKey = '↓';
        else if (key === 'ArrowLeft') normalizedKey = '←';
        else if (key === 'ArrowRight') normalizedKey = '→';
        else if (key === 'Home') normalizedKey = 'home';
        else if (key === 'End') normalizedKey = 'end';
        else if (key === 'PageUp') normalizedKey = 'pageup';
        else if (key === 'PageDown') normalizedKey = 'pagedown';
        else if (key === 'Insert') normalizedKey = 'insert';
        else if (key === 'Delete') normalizedKey = 'delete';
        else if (key.startsWith('F') && key.length <= 3) normalizedKey = key;
        
        const engKey = normalizeRusKey(normalizedKey);
        
        if (!isKeyAllowed(engKey)) {
            const displayName = getKeyDisplayName(engKey);
            showKeyBindingNotification(`⛔ Клавиша "${displayName || key}" ЗАПРЕЩЕНА! Разрешены: буквы, цифры, стрелки и F1-F12.`);
            if (bindingTarget) {
                const card = document.getElementById(`card-${bindingTarget}`);
                if (card) {
                    card.style.borderColor = '#e74c3c';
                    card.style.boxShadow = '0 0 20px rgba(231, 76, 60, 0.4)';
                    setTimeout(() => {
                        card.style.borderColor = '';
                        card.style.boxShadow = '';
                    }, 1000);
                }
            }
            keyBindingMode = false;
            if (bindingTarget) {
                const card = document.getElementById(`card-${bindingTarget}`);
                if (card) {
                    card.style.boxShadow = '';
                    card.style.borderColor = '';
                }
                bindingTarget = null;
            }
            renderKeyBindingsUI();
            return;
        }
        
        const musicKeys = window._userHotkeys || {};
        let isMusicKeyTaken = false;
        let musicAction = '';
        for (let action in musicKeys) {
            if (normalizeRusKey(musicKeys[action]) === engKey) {
                isMusicKeyTaken = true;
                musicAction = action;
                break;
            }
        }
        
        if (isMusicKeyTaken) {
            const actionNames = {
                'pause_all': 'Пауза всех',
                'stop_all': 'Остановить всё',
                'next_track': 'Следующий трек',
                'prev_track': 'Предыдущий трек',
                'volume_up': 'Громкость +',
                'volume_down': 'Громкость -'
            };
            const actionName = actionNames[musicAction] || musicAction;
            showKeyBindingNotification(`⚠️ Клавиша "${getKeyDisplayName(engKey)}" уже используется в музыке (${actionName})`);
            if (bindingTarget) {
                const card = document.getElementById(`card-${bindingTarget}`);
                if (card) {
                    card.style.borderColor = '#f39c12';
                    card.style.boxShadow = '0 0 20px rgba(243, 156, 18, 0.4)';
                    setTimeout(() => {
                        card.style.borderColor = '';
                        card.style.boxShadow = '';
                    }, 1000);
                }
            }
            keyBindingMode = false;
            if (bindingTarget) {
                const card = document.getElementById(`card-${bindingTarget}`);
                if (card) {
                    card.style.boxShadow = '';
                    card.style.borderColor = '';
                }
                bindingTarget = null;
            }
            renderKeyBindingsUI();
            return;
        }
        
        const isSoundKeyTaken = Object.keys(keyBindings).some(k => {
            return normalizeRusKey(k) === engKey && keyBindings[k] !== bindingTarget;
        });
        
        if (isSoundKeyTaken) {
            showKeyBindingNotification(`⚠️ Клавиша "${getKeyDisplayName(engKey)}" уже используется на другом звуке`);
            if (bindingTarget) {
                const card = document.getElementById(`card-${bindingTarget}`);
                if (card) {
                    card.style.borderColor = '#f39c12';
                    card.style.boxShadow = '0 0 20px rgba(243, 156, 18, 0.4)';
                    setTimeout(() => {
                        card.style.borderColor = '';
                        card.style.boxShadow = '';
                    }, 1000);
                }
            }
            keyBindingMode = false;
            if (bindingTarget) {
                const card = document.getElementById(`card-${bindingTarget}`);
                if (card) {
                    card.style.boxShadow = '';
                    card.style.borderColor = '';
                }
                bindingTarget = null;
            }
            renderKeyBindingsUI();
            return;
        }
        
        if (bindingTarget) {
            for (let k in keyBindings) {
                if (keyBindings[k] === bindingTarget) {
                    delete keyBindings[k];
                }
            }
            keyBindings[engKey] = bindingTarget;
            saveKeyBindingsSession();
            
            if (keyVolumes[engKey] !== undefined) {
                const vol = keyVolumes[engKey];
                const soundId = bindingTarget;
                if (audioObjects[soundId]) {
                    audioObjects[soundId].volume = vol;
                    if (audioObjects[soundId].audio) {
                        audioObjects[soundId].audio.volume = vol / 100;
                    }
                    const card = document.getElementById(`card-${soundId}`);
                    if (card) {
                        const slider = card.querySelector(`#vol-${soundId}`);
                        const volDisplay = card.querySelector(`#val-${soundId}`);
                        if (slider) {
                            slider.value = vol;
                            slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${vol}%, rgba(255,255,255,0.15) ${vol}%, rgba(255,255,255,0.15) 100%)`;
                        }
                        if (volDisplay) volDisplay.textContent = vol + '%';
                    }
                }
            }
            
            const card = document.getElementById(`card-${bindingTarget}`);
            if (card) {
                card.style.boxShadow = '';
                card.style.borderColor = '';
                card.style.borderColor = '#27ae60';
                card.style.boxShadow = '0 0 20px rgba(39, 174, 96, 0.3)';
                setTimeout(() => {
                    card.style.borderColor = '';
                    card.style.boxShadow = '';
                }, 800);
            }
            
            keyBindingMode = false;
            const displayName = getKeyDisplayName(engKey);
            showKeyBindingNotification(`✅ Клавиша "${displayName}" назначена на звук`);
            renderKeyBindingsUI();
            updateAllKeyDisplays();
            bindingTarget = null;
        }
        return;
    }
    
    // === ГОРЯЧИЕ КЛАВИШИ ДЛЯ МУЗЫКИ ===
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
        return;
    }
    
    let key = e.key;
    const engKey = normalizeRusKey(key);
    
    let userHotkeys = window._userHotkeys || {};
    
    if (Object.keys(userHotkeys).length === 0) {
        try {
            const saved = sessionStorage.getItem('dragonSound_keyBindings');
            if (saved) {
                const parsed = JSON.parse(saved);
                if (parsed) {
                    userHotkeys = {
                        'pause_all': 'p',
                        'stop_all': 'o',
                        'next_track': 'ArrowRight',
                        'prev_track': 'ArrowLeft',
                        'volume_up': 'ArrowUp',
                        'volume_down': 'ArrowDown'
                    };
                    window._userHotkeys = userHotkeys;
                }
            }
        } catch(e) {}
    }
    
    if (Object.keys(userHotkeys).length === 0) {
        userHotkeys = {
            'pause_all': 'p',
            'stop_all': 'o',
            'next_track': 'ArrowRight',
            'prev_track': 'ArrowLeft',
            'volume_up': 'ArrowUp',
            'volume_down': 'ArrowDown'
        };
        window._userHotkeys = userHotkeys;
    }
    
    const isMusicKey = Object.values(userHotkeys).some(val => normalizeRusKey(val) === engKey);
    
    if (isMusicKey) {
        e.preventDefault();
        e.stopPropagation();
    }
    
    if (userHotkeys.pause_all && normalizeRusKey(userHotkeys.pause_all) === engKey) {
        if (activeMusicSource !== 'local') {
            const action = externalMusicPaused ? 'play' : 'pause';
            if (controlExternalMusic(action)) {
                externalMusicPaused = action === 'pause';
                showKeyBindingNotification(externalMusicPaused ? 'Пауза внешней музыки' : 'Продолжить внешнюю музыку');
            }
        }
        pauseAllSoundsAndMusic();
        return;
    }
    
    if (userHotkeys.stop_all && normalizeRusKey(userHotkeys.stop_all) === engKey) {
        if (activeMusicSource !== 'local') {
            controlExternalMusic('stop');
            externalMusicPaused = true;
        }
        stopAllSoundsAndMusic();
        return;
    }
    
    if (userHotkeys.next_track && normalizeRusKey(userHotkeys.next_track) === engKey) {
        if (activeMusicSource !== 'local') {
            if (controlExternalMusic('next')) showKeyBindingNotification('Следующий трек');
            else showKeyBindingNotification('VK не разрешает переключать треки горячей клавишей');
            return;
        }
        const nextBtn = document.getElementById('nextBtn');
        if (nextBtn) {
            nextBtn.click();
            showKeyBindingNotification('⏭ Следующий трек');
        }
        return;
    }
    
    if (userHotkeys.prev_track && normalizeRusKey(userHotkeys.prev_track) === engKey) {
        if (activeMusicSource !== 'local') {
            if (controlExternalMusic('previous')) showKeyBindingNotification('Предыдущий трек');
            else showKeyBindingNotification('VK не разрешает переключать треки горячей клавишей');
            return;
        }
        const prevBtn = document.getElementById('prevBtn');
        if (prevBtn) {
            prevBtn.click();
            showKeyBindingNotification('⏮ Предыдущий трек');
        }
        return;
    }
    
    if (userHotkeys.volume_up && normalizeRusKey(userHotkeys.volume_up) === engKey) {
        const slider = document.getElementById('musicVolume');
        if (slider) {
            const newVal = Math.min(100, parseInt(slider.value) + 5);
            slider.value = newVal;
            slider.dispatchEvent(new Event('input'));
            if (activeMusicSource !== 'local' && !controlExternalMusic('volume', newVal)) {
                showKeyBindingNotification('VK не разрешает менять громкость горячей клавишей');
                return;
            }
            try {
                const settings = JSON.parse(sessionStorage.getItem('dragonSound_user_settings') || '{}');
                settings.music_volume = newVal;
                sessionStorage.setItem('dragonSound_user_settings', JSON.stringify(settings));
            } catch (err) {}
            showKeyBindingNotification(`🔊 Громкость: ${newVal}%`);
        }
        return;
    }
    
    if (userHotkeys.volume_down && normalizeRusKey(userHotkeys.volume_down) === engKey) {
        const slider = document.getElementById('musicVolume');
        if (slider) {
            const newVal = Math.max(0, parseInt(slider.value) - 5);
            slider.value = newVal;
            slider.dispatchEvent(new Event('input'));
            if (activeMusicSource !== 'local' && !controlExternalMusic('volume', newVal)) {
                showKeyBindingNotification('VK не разрешает менять громкость горячей клавишей');
                return;
            }
            try {
                const settings = JSON.parse(sessionStorage.getItem('dragonSound_user_settings') || '{}');
                settings.music_volume = newVal;
                sessionStorage.setItem('dragonSound_user_settings', JSON.stringify(settings));
            } catch (err) {}
            showKeyBindingNotification(`🔈 Громкость: ${newVal}%`);
        }
        return;
    }
    
    const normalizedKey = normalizeKey(key);
    const soundId = getSoundIdByKey(normalizedKey);
    if (soundId) {
        toggleSound(soundId);
        const wrapper = document.querySelector(`.key-bind-wrapper[data-sound="${soundId}"]`);
        if (wrapper) {
            const btn = wrapper.querySelector('.key-bind-btn');
            if (btn) {
                btn.classList.add('pressed');
                setTimeout(() => {
                    btn.classList.remove('pressed');
                }, 300);
            }
        }
    }
}

// ============ ИЗМЕНЕНИЕ ГРОМКОСТИ КЛАВИШИ ============
window.changeKeyVolume = function(key, value) {
    const vol = parseInt(value);
    if (isNaN(vol) || vol < 0 || vol > 100) return;
    
    const soundId = keyBindings[key];
    if (!soundId || !audioObjects[soundId]) return;
    
    console.log(`🔊 Изменение громкости для клавиши "${key}": ${vol}% (звук: ${soundId})`);
    
    const data = audioObjects[soundId];
    data.volume = vol;
    if (data.audio) {
        data.audio.volume = vol / 100;
    }
    
    const card = document.getElementById(`card-${soundId}`);
    if (card) {
        const slider = card.querySelector(`#vol-${soundId}`);
        const volDisplay = card.querySelector(`#val-${soundId}`);
        if (slider) {
            slider.value = vol;
            slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${vol}%, rgba(255,255,255,0.15) ${vol}%, rgba(255,255,255,0.15) 100%)`;
        }
        if (volDisplay) {
            volDisplay.textContent = vol + '%';
        }
    }
    
    keyVolumes[key] = vol;
    window._currentKeyVolumes = keyVolumes;
    saveKeyVolumesSession();
    
    const container = document.getElementById('keyBindingsContainer');
    if (container) {
        const volDisplay = container.querySelector(`.vol-value[data-key="${key}"]`);
        if (volDisplay) {
            volDisplay.textContent = vol + '%';
        }
        const slider = container.querySelector(`.key-volume-slider[data-key="${key}"]`);
        if (slider) {
            slider.value = vol;
            slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${vol}%, rgba(255,255,255,0.15) ${vol}%, rgba(255,255,255,0.15) 100%)`;
        }
    }
};

// ============ РЕНДЕР ГОРЯЧИХ КЛАВИШ ============
function renderKeyBindingsUI() {
    const container = document.getElementById('keyBindingsContainer');
    if (!container) return;
    
    const soundItems = [];
    for (let soundId in audioObjects) {
        const card = document.getElementById(`card-${soundId}`);
        if (card) {
            const name = card.querySelector('.sound-card-name')?.textContent || soundId;
            soundItems.push({ id: soundId, name });
        }
    }
    
    const musicKeys = ['pause_all', 'stop_all', 'next_track', 'prev_track', 'volume_up', 'volume_down'];
    
    const assignedKeys = Object.keys(keyBindings).filter(k => {
        const soundId = keyBindings[k];
        return !musicKeys.includes(k) && soundId && audioObjects[soundId];
    });
    
    const totalKeys = availableKeys.length;
    
    container.innerHTML = `
        <div style="display:flex;flex-direction:column;gap:4px;padding:5px 0;">
            ${assignedKeys.length === 0 ? `
                <div class="key-bind-empty">
                    <span>⌨</span>
                    Нет назначенных клавиш для звуков.<br>
                    Нажмите <strong style="color:var(--accent);">⋯</strong> на карточке звука для назначения
                </div>
            ` : `
                <div style="font-size:0.65em;color:var(--text-secondary);margin-bottom:4px;opacity:0.5;padding:0 4px;">
                    Клавиши для звуков (${assignedKeys.length}):
                </div>
                ${assignedKeys.map(key => {
                    const soundId = keyBindings[key];
                    const soundName = soundId ? soundItems.find(s => s.id === soundId)?.name || '🔊' : '—';
                    const displayName = getKeyDisplayName(key);
                    let currentVolume = 50;
                    if (soundId && audioObjects[soundId]) {
                        currentVolume = audioObjects[soundId].volume;
                    }
                    return `
                        <div class="key-binding-row" data-key="${key}" data-sound="${soundId || ''}">
                            <div class="key-display">${displayName.length > 4 ? displayName.substring(0, 4) : displayName}</div>
                            <span class="key-name" title="${soundName}">${soundName}</span>
                            <div class="key-volume">
                                <span class="vol-icon">🔈</span>
                                <input type="range" min="0" max="100" value="${currentVolume}" 
                                       data-key="${key}"
                                       class="key-volume-slider">
                                <span class="vol-value" data-key="${key}">${currentVolume}%</span>
                            </div>
                            <button class="btn-unbind" onclick="unbindKey('${key}')" title="Отвязать клавишу">✕</button>
                        </div>
                    `;
                }).join('')}
            `}
        </div>
        <div class="key-bind-actions">
            <button class="btn btn-reset" onclick="clearAllKeyBindings()">🗑 Сбросить все</button>
            <button class="btn btn-help" onclick="showKeyBindingHelp()">❓ Помощь</button>
            <span class="key-count">${assignedKeys.length} / ${totalKeys}</span>
        </div>
    `;
    
    container.querySelectorAll('.key-volume-slider').forEach(slider => {
        const key = slider.dataset.key;
        const value = slider.value;
        
        slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${value}%, rgba(255,255,255,0.15) ${value}%, rgba(255,255,255,0.15) 100%)`;
        
        slider.addEventListener('input', function(e) {
            e.stopPropagation();
            const newValue = this.value;
            const key = this.dataset.key;
            
            this.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${newValue}%, rgba(255,255,255,0.15) ${newValue}%, rgba(255,255,255,0.15) 100%)`;
            
            const volDisplay = this.closest('.key-volume').querySelector('.vol-value');
            if (volDisplay) {
                volDisplay.textContent = newValue + '%';
            }
            
            changeKeyVolume(key, newValue);
        });
        
        slider.addEventListener('mousedown', function(e) {
            e.stopPropagation();
        });
        
        slider.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    });
}

