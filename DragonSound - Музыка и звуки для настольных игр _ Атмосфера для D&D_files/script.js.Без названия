window.startKeyBinding = function(soundId) {
    if (!isLoggedIn()) {
        showAuthRequiredModal('Чтобы назначать горячие клавиши на звуки, нужно зарегистрироваться — иначе привязки будут слетать при каждом заходе на сайт.');
        return;
    }
    if (keyBindingMode) {
        showKeyBindingNotification('❌ Сначала завершите текущее назначение (Esc)');
        return;
    }
    keyBindingMode = true;
    bindingTarget = soundId;
    const soundName = document.getElementById(`card-${soundId}`)?.querySelector('.sound-card-name')?.textContent || 'звук';
    const card = document.getElementById(`card-${soundId}`);
    if (card) {
        card.style.boxShadow = '0 0 30px rgba(255,69,0,0.4)';
        card.style.borderColor = 'var(--accent)';
    }
    showKeyBindingNotification(`🎯 Нажмите ЛЮБУЮ клавишу для "${soundName}" (Esc - отмена)`);
    renderKeyBindingsUI();
};

window.unbindKey = function(key) {
    const soundId = keyBindings[key];
    
    const engKey = normalizeRusKey(key);
    const keysToDelete = Object.keys(keyBindings).filter(k => normalizeRusKey(k) === engKey);
    keysToDelete.forEach(k => {
        delete keyBindings[k];
    });
    
    saveKeyBindingsSession();
    
    const volumesToDelete = Object.keys(keyVolumes).filter(k => normalizeRusKey(k) === engKey);
    volumesToDelete.forEach(k => {
        delete keyVolumes[k];
    });
    saveKeyVolumesSession();
    
    renderKeyBindingsUI();
    updateAllKeyDisplays();
    
    if (soundId) {
        const card = document.getElementById(`card-${soundId}`);
        if (card) {
            card.style.boxShadow = '';
            card.style.borderColor = '';
        }
        if (audioObjects[soundId]) {
            audioObjects[soundId].volume = 50;
            if (audioObjects[soundId].audio) {
                audioObjects[soundId].audio.volume = 0.5;
            }
            const slider = card.querySelector(`#vol-${soundId}`);
            const volDisplay = card.querySelector(`#val-${soundId}`);
            if (slider) {
                slider.value = 50;
                slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) 50%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0.15) 100%)`;
            }
            if (volDisplay) volDisplay.textContent = '50%';
        }
    }
    
    showKeyBindingNotification(`✅ Клавиша "${getKeyDisplayName(key)}" отвязана`);
};

window.clearAllKeyBindings = function() {
    if (!confirm('Сбросить все назначенные клавиши?')) return;
    
    const soundIds = Object.values(keyBindings);
    
    keyBindings = {};
