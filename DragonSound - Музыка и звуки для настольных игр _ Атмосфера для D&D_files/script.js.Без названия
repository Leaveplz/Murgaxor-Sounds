const AUDIO_CACHE_NAME = 'dragon-sound-audio-v1';
let audioCacheAbortController = null;
let audioCacheUIReady = false;
let audioCacheInspectTimer = null;
const cachedAudioObjectUrls = new Map();
const cachedAudioSourcePromises = new Map();

async function getCacheFirstAudioSource(file) {
    const absoluteUrl = new URL(file, window.location.href).href;
    if (cachedAudioObjectUrls.has(absoluteUrl)) return cachedAudioObjectUrls.get(absoluteUrl);
    if (cachedAudioSourcePromises.has(absoluteUrl)) return cachedAudioSourcePromises.get(absoluteUrl);
    const lookup = (async () => {
        if (!('caches' in window)) return absoluteUrl;
        try {
            const cache = await caches.open(AUDIO_CACHE_NAME);
            const response = await cache.match(absoluteUrl, { ignoreSearch: true, ignoreVary: true });
            // Opaque-ответ нельзя преобразовать в Blob — его по-прежнему отдаёт Service Worker.
            if (!response || response.type === 'opaque') return absoluteUrl;
            const blob = await response.blob();
            if (!blob.size) return absoluteUrl;
            const objectUrl = URL.createObjectURL(blob);
            cachedAudioObjectUrls.set(absoluteUrl, objectUrl);
            return objectUrl;
        } catch (error) {
            return absoluteUrl;
        }
    })();
    cachedAudioSourcePromises.set(absoluteUrl, lookup);
    try {
        return await lookup;
    } finally {
        cachedAudioSourcePromises.delete(absoluteUrl);
    }
}

async function setCacheFirstAudioSource(audio, file) {
    if (!audio || !file) return false;
    const source = await getCacheFirstAudioSource(file);
    if (audio.src !== source) {
        audio.src = source;
        audio.load();
    }
    return true;
}

window.addEventListener('pagehide', () => {
    cachedAudioObjectUrls.forEach(url => URL.revokeObjectURL(url));
    cachedAudioObjectUrls.clear();
});

function getAllAudioUrls() {
    if (!config) return [];
    const files = [];
    Object.values(config.sounds || {}).forEach(group => {
        (group.items || []).forEach(item => { if (item.file) files.push(item.file); });
    });
    Object.values(config.music || {}).forEach(tracks => {
        (tracks || []).forEach(track => { if (track.file) files.push(track.file); });
    });
    return [...new Set(files.map(file => new URL(file, window.location.href).href))];
}

function formatCacheBytes(bytes) {
    if (!Number.isFinite(bytes) || bytes <= 0) return '0 МБ';
    const mb = bytes / (1024 * 1024);
    return `${mb < 10 ? mb.toFixed(1) : Math.round(mb)} МБ`;
}

function setAudioCacheProgress(done, total, bytes, status) {
    const panel = document.getElementById('audioCachePanel');
    const progress = document.getElementById('audioCacheProgress');
    const fill = document.getElementById('audioCacheProgressFill');
    const count = document.getElementById('audioCacheCount');
    const size = document.getElementById('audioCacheSize');
    const statusNode = document.getElementById('audioCacheStatus');
    const percent = total ? Math.min(100, Math.round(done / total * 100)) : 0;
    if (fill) fill.style.width = `${percent}%`;
    if (progress) progress.setAttribute('aria-valuenow', String(percent));
    if (count) count.textContent = `${done} / ${total} файлов`;
    if (size) size.textContent = formatCacheBytes(bytes);
    if (statusNode && status) statusNode.textContent = status;
    if (panel) panel.classList.toggle('is-complete', total > 0 && done >= total);
}

async function inspectAudioCache() {
    const urls = getAllAudioUrls();
    const panel = document.getElementById('audioCachePanel');
    if (!('caches' in window)) {
        if (panel) panel.hidden = false;
        setAudioCacheProgress(0, urls.length, 0, 'Браузер не поддерживает офлайн-кэш');
        return;
    }
    const cache = await caches.open(AUDIO_CACHE_NAME);
    const urlSet = new Set(urls);
    const keys = await cache.keys();
    const savedKeys = keys.filter(request => urlSet.has(request.url));
    const saved = savedKeys.length;
    const sizes = await Promise.all(savedKeys.map(request => cache.match(request).then(response =>
        response ? Number(response.headers.get('content-length')) || 0 : 0
    )));
    const usedBytes = sizes.reduce((sum, size) => sum + size, 0);
    const status = saved === urls.length && urls.length
        ? 'Все звуки и треки готовы без повторной загрузки'
        : saved ? `Сохранено ${saved} из ${urls.length}` : 'Скачайте аудио для быстрого повторного запуска';
    setAudioCacheProgress(saved, urls.length, usedBytes, status);
    const isComplete = urls.length > 0 && saved === urls.length;
    if (panel) {
        panel.hidden = urls.length === 0 || isComplete;
        if (panel.hidden) panel.classList.remove('is-open');
    }
    const toggle = document.getElementById('audioCacheToggle');
    if (toggle && panel?.hidden) toggle.setAttribute('aria-expanded', 'false');
    const clearBtn = document.getElementById('clearAudioCacheBtn');
    if (clearBtn) clearBtn.hidden = saved === 0;
}

async function preloadAllAudio() {
    const button = document.getElementById('preloadAudioBtn');
    const panel = document.getElementById('audioCachePanel');
    if (audioCacheAbortController) {
        audioCacheAbortController.abort();
        return;
    }
    const urls = getAllAudioUrls();
    if (!urls.length || !('caches' in window)) return;

    audioCacheAbortController = new AbortController();
    const controller = audioCacheAbortController;
    if (navigator.storage && navigator.storage.persist) navigator.storage.persist().catch(() => {});
    if (button) button.textContent = 'Остановить загрузку';
    if (panel) panel.classList.add('is-loading');

    let completed = 0;
    let downloadedBytes = 0;
    let failed = 0;
    let quotaExceeded = false;
    const cache = await caches.open(AUDIO_CACHE_NAME);
    const queue = urls.slice();

    async function downloadNext() {
        while (queue.length && !controller.signal.aborted) {
            const url = queue.shift();
            try {
                const existing = await cache.match(url);
                if (!existing) {
                    const isSameOrigin = new URL(url).origin === window.location.origin;
                    const request = new Request(url, {
                        credentials: isSameOrigin ? 'same-origin' : 'omit',
                        mode: isSameOrigin ? 'same-origin' : 'no-cors'
                    });
                    const response = await fetch(request, { cache: 'no-store', signal: controller.signal });
                    if (!response.ok && response.type !== 'opaque') throw new Error(`HTTP ${response.status}`);
                    const contentLength = Number(response.headers.get('content-length')) || 0;
                    await cache.put(request, response.clone());
                    downloadedBytes += contentLength;
                }
            } catch (error) {
                if (error.name === 'AbortError') break;
                failed++;
                if (error.name === 'QuotaExceededError' || String(error).toLowerCase().includes('quota')) {
                    quotaExceeded = true;
                    controller.abort();
                }
                console.warn('Не удалось сохранить аудиофайл:', url, error);
            }
            completed++;
            setAudioCacheProgress(completed, urls.length, downloadedBytes,
                failed ? `Загрузка продолжается · ошибок: ${failed}` : 'Сохраняем звуки и треки…');
        }
    }

    try {
        await Promise.all([downloadNext(), downloadNext(), downloadNext()]);
        if (quotaExceeded) {
            setAudioCacheProgress(completed - failed, urls.length, downloadedBytes, 'Недостаточно места в памяти браузера');
        } else if (controller.signal.aborted) {
            setAudioCacheProgress(completed, urls.length, downloadedBytes, 'Загрузка остановлена — можно продолжить позже');
        } else if (failed) {
            setAudioCacheProgress(completed - failed, urls.length, downloadedBytes, `Готово, не удалось скачать: ${failed}`);
        } else {
            setAudioCacheProgress(urls.length, urls.length, downloadedBytes, 'Готово — всё аудио сохранено в кэше');
        }
    } catch (error) {
        const quota = error && (error.name === 'QuotaExceededError' || String(error).includes('quota'));
        setAudioCacheProgress(completed, urls.length, downloadedBytes,
            quota ? 'Недостаточно места в памяти браузера' : 'Загрузка прервана — попробуйте ещё раз');
    } finally {
        audioCacheAbortController = null;
        if (button) button.textContent = !failed && completed >= urls.length ? 'Аудио уже сохранено' : 'Скачать недостающие';
        if (panel) panel.classList.remove('is-loading');
        const clearBtn = document.getElementById('clearAudioCacheBtn');
        if (clearBtn && completed - failed > 0) clearBtn.hidden = false;
        await inspectAudioCache().catch(() => {});
    }
}

async function clearAudioCache() {
    if (audioCacheAbortController) audioCacheAbortController.abort();
    await caches.delete(AUDIO_CACHE_NAME);
    setAudioCacheProgress(0, getAllAudioUrls().length, 0, 'Кэш аудио очищен');
    const clearBtn = document.getElementById('clearAudioCacheBtn');
    if (clearBtn) clearBtn.hidden = true;
    const panel = document.getElementById('audioCachePanel');
    if (panel) panel.hidden = false;
}

function initAudioCacheUI() {
    if (audioCacheUIReady) {
        inspectAudioCache().catch(() => {});
        return;
    }
    audioCacheUIReady = true;
    const panel = document.getElementById('audioCachePanel');
    const toggle = document.getElementById('audioCacheToggle');
    // backdrop-filter у шапки создаёт отдельную систему координат для fixed-элементов.
    // Выносим виджет в body, чтобы он всегда был привязан к окну браузера.
    if (panel && panel.parentElement !== document.body) document.body.appendChild(panel);
    toggle?.addEventListener('click', () => {
        const willOpen = !panel?.classList.contains('is-open');
        panel?.classList.toggle('is-open', willOpen);
        toggle.setAttribute('aria-expanded', String(willOpen));
        toggle.setAttribute('aria-label', willOpen ? 'Закрыть предзагрузку аудио' : 'Открыть предзагрузку аудио');
    });
    document.addEventListener('click', event => {
        if (panel && panel.classList.contains('is-open') && !panel.contains(event.target)) {
            panel.classList.remove('is-open');
            toggle?.setAttribute('aria-expanded', 'false');
        }
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && panel?.classList.contains('is-open')) {
            panel.classList.remove('is-open');
            toggle?.setAttribute('aria-expanded', 'false');
            toggle?.focus();
        }
    });
    document.getElementById('preloadAudioBtn')?.addEventListener('click', preloadAllAudio);
    document.getElementById('clearAudioCacheBtn')?.addEventListener('click', clearAudioCache);
    inspectAudioCache().catch(() => {});
    audioCacheInspectTimer = setInterval(() => inspectAudioCache().catch(() => {}), 60000);

    if ('serviceWorker' in navigator && window.location.protocol !== 'file:') {
        navigator.serviceWorker.register('sw.js?v=20260814-14', { updateViaCache: 'none' }).then(registration => {
            registration.update().catch(() => {});
        }).catch(error => {
            console.warn('Не удалось включить офлайн-воспроизведение:', error);
        });
    } else if (window.location.protocol === 'file:') {
        const status = document.getElementById('audioCacheStatus');
        if (status) status.textContent = 'Офлайн-кэш работает после загрузки сайта на хостинг';
    }
}

