let isSaving = false;

async function saveAllSettingsManually() {
    const btn = document.getElementById('saveSettingsBtn');
    const bigBtn = document.getElementById('saveBigSettingsBtn');
    
    if (isSaving) {
        showSaveNotification('⏳ Уже сохраняется...', 'info');
        return;
    }
    
    const userData = getUserData();
    const token = getSessionToken();
    const loggedIn = isLoggedIn();
    
    if (!userData.email || !token || !loggedIn) {
        showSaveNotification('❌ Вы не авторизованы', 'error');
        return;
    }
    
    isSaving = true;
    
    if (btn) { btn.classList.add('saving'); setHeaderSaveBtnState(btn, 'saving'); btn.title = 'Сохранение...'; }
    if (bigBtn) { bigBtn.classList.add('saving'); bigBtn.innerHTML = '⏳ Сохранение...'; bigBtn.disabled = true; }
    
    try {
        const soundVolumes = {};
        for (let soundId in audioObjects) {
            if (audioObjects[soundId] && typeof audioObjects[soundId].volume === 'number') {
                soundVolumes[soundId] = Math.min(100, Math.max(0, audioObjects[soundId].volume));
            }
        }
        
        const musicVol = parseInt(document.getElementById('musicVolume')?.value || 50);
        const currentKeyBindings = window._currentKeyBindings || keyBindings || {};
        const currentKeyVolumes = window._currentKeyVolumes || keyVolumes || {};
        
        const settings = {
            music_volume: musicVol,
            soundVolumes: soundVolumes,
            keyBindings: currentKeyBindings,
            keyVolumes: currentKeyVolumes
        };
        
        const response = await fetch('api.php?action=save_settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                email: userData.email,
                session_token: token,
                settings: settings
            })
        });
        
        const data = await response.json();
        
        if (response.status === 401) {
            showSaveNotification('⚠️ Сессия истекла, войдите заново', 'error');
            sessionStorage.clear();
            setTimeout(() => {
                window.location.href = 'login.html';
            }, 2000);
            
            if (btn) { btn.classList.remove('saving'); setHeaderSaveBtnState(btn, 'idle'); btn.title = 'Сохранить настройки'; }
            if (bigBtn) { bigBtn.classList.remove('saving'); bigBtn.textContent = 'Сохранить настройки'; bigBtn.disabled = false; }
            isSaving = false;
            return;
        }
        
        if (data.success) {
            // ===== ВАЖНО: ИСПОЛЬЗУЕМ sessionStorage! =====
            try {
                sessionStorage.setItem('dragonSound_user_settings', JSON.stringify(settings));
                sessionStorage.setItem('dragonSound_soundVolumes', JSON.stringify(soundVolumes));
                sessionStorage.setItem('dragonSound_keyBindings', JSON.stringify(currentKeyBindings));
            } catch (e) {}
            
            if (btn) { btn.classList.remove('saving'); btn.classList.add('saved'); setHeaderSaveBtnState(btn, 'saved'); btn.title = 'Сохранено!'; }
            if (bigBtn) { bigBtn.classList.remove('saving'); bigBtn.classList.add('saved'); bigBtn.innerHTML = '✅ Сохранено!'; bigBtn.disabled = false; }
            
            showSaveNotification('✅ Все настройки сохранены!', 'success');
            
            setTimeout(() => {
                if (btn) { btn.classList.remove('saved'); setHeaderSaveBtnState(btn, 'idle'); btn.title = 'Сохранить настройки'; }
                if (bigBtn) { bigBtn.classList.remove('saved'); bigBtn.textContent = 'Сохранить настройки'; bigBtn.disabled = false; }
            }, 3000);
        } else {
            if (btn) { btn.classList.remove('saving'); btn.classList.add('error'); setHeaderSaveBtnState(btn, 'error'); btn.title = 'Ошибка сохранения'; }
            if (bigBtn) { bigBtn.classList.remove('saving'); bigBtn.classList.add('error'); bigBtn.innerHTML = '❌ Ошибка!'; bigBtn.disabled = false; }
            
            showSaveNotification('❌ ' + (data.error || 'Ошибка сохранения'), 'error');
            
            setTimeout(() => {
                if (btn) { btn.classList.remove('error'); setHeaderSaveBtnState(btn, 'idle'); btn.title = 'Сохранить настройки'; }
                if (bigBtn) { bigBtn.classList.remove('error'); bigBtn.textContent = 'Сохранить настройки'; bigBtn.disabled = false; }
            }, 3000);
        }
    } catch (error) {
        console.error('❌ Ошибка сохранения:', error);
        
        if (btn) { btn.classList.remove('saving'); btn.classList.add('error'); setHeaderSaveBtnState(btn, 'error'); btn.title = 'Ошибка сохранения'; }
        if (bigBtn) { bigBtn.classList.remove('saving'); bigBtn.classList.add('error'); bigBtn.innerHTML = '❌ Ошибка!'; bigBtn.disabled = false; }
        
        showSaveNotification('❌ Ошибка соединения с сервером', 'error');
        
        setTimeout(() => {
            if (btn) { btn.classList.remove('error'); setHeaderSaveBtnState(btn, 'idle'); btn.title = 'Сохранить настройки'; }
            if (bigBtn) { bigBtn.classList.remove('error'); bigBtn.textContent = 'Сохранить настройки'; bigBtn.disabled = false; }
        }, 3000);
    } finally {
        isSaving = false;
    }
}

function showSaveNotification(message, type = 'info') {
    let notification = document.getElementById('saveNotification');
    if (!notification) {
        notification = document.createElement('div');
        notification.id = 'saveNotification';
        notification.className = 'save-notification';
        document.body.appendChild(notification);
    }
    
    notification.textContent = message;
    notification.className = 'save-notification ' + type + ' show';
    
    clearTimeout(notification._timeout);
    notification._timeout = setTimeout(() => {
        notification.classList.remove('show');
    }, 3000);
}

