// Горячие клавиши раньше сохранялись только в sessionStorage. При следующей
// загрузке страницы loadUserSettings() подтягивает настройки с сервера и
// перезаписывает ими keyBindings (даже пустым объектом — он "истинный" в JS),
// поэтому несохранённая вручную привязка бесследно исчезала. Тихо досылаем
// изменение на сервер сразу, чтобы клавиши не "переставали работать" сами по себе.
let __keyBindingsSyncTimer = null;
function autoSaveKeyBindingsToServer() {
    if (!isLoggedIn || typeof isLoggedIn !== 'function' || !isLoggedIn()) return;
    if (__keyBindingsSyncTimer) clearTimeout(__keyBindingsSyncTimer);
    __keyBindingsSyncTimer = setTimeout(async () => {
        try {
            const userData = getUserData();
            const token = getSessionToken();
            if (!userData.email || !token) return;
            await fetch('api.php?action=save_settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    email: userData.email,
                    session_token: token,
                    settings: { keyBindings: keyBindings, keyVolumes: keyVolumes }
                })
            });
        } catch (e) {
            console.warn('⚠️ Не удалось синхронизировать горячие клавиши с сервером:', e);
        }
    }, 600);
}

