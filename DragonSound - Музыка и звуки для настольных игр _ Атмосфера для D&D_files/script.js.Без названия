                font-size: 0.8em;
                transition: all 0.3s;
            ">Обновить</button>
            <button onclick="dismissUpdate()" style="
                background: transparent;
                color: var(--text-secondary);
                border: none;
                cursor: pointer;
                font-size: 1.2em;
                padding: 0 4px;
            ">✕</button>
        `;
        
        document.body.appendChild(notification);
    }
    
    notification.style.opacity = '1';
    notification.style.transform = 'translateX(-50%) translateY(0)';
}

window.dismissUpdate = function() {
    updateNotificationShown = false;
    const notification = document.getElementById('updateNotification');
    if (notification) {
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(-50%) translateY(20px)';
        setTimeout(() => {
            if (notification.parentNode) notification.parentNode.removeChild(notification);
        }, 500);
    }
};

window.applyUpdate = function() {
    if (window._pendingConfig) {
        const oldKeyBindings = JSON.parse(JSON.stringify(keyBindings));
        const oldKeyVolumes = JSON.parse(JSON.stringify(keyVolumes));
        
        config = window._pendingConfig;
        window._pendingConfig = null;
        
        keyBindings = oldKeyBindings;
        keyVolumes = oldKeyVolumes;
        saveKeyBindingsSession();
        saveKeyVolumesSession();
        
        stopAllSounds();
        renderCategories();
        renderSounds();
        loadPlaylist(currentCategory);
        applyBackground();
        
        setTimeout(() => {
            updateAllKeyDisplays();
            renderKeyBindingsUI();
        }, 100);
        
        updateNotificationShown = false;
        const notification = document.getElementById('updateNotification');
        if (notification) {
            notification.style.opacity = '0';
            notification.style.transform = 'translateX(-50%) translateY(20px)';
            setTimeout(() => {
                if (notification.parentNode) notification.parentNode.removeChild(notification);
            }, 500);
        }
        
        lastConfigHash = getConfigHash();
        
        showUpdateNotification('✅ Настройки обновлены!');
    }
};

async function checkForUpdatesWithNotification() {
    // Не нагружаем PHP в фоновой/свёрнутой вкладке.
    if (document.hidden) return;
    try {
        const response = await fetch('config_sync.php?' + Date.now(), {
            method: 'GET',
            headers: { 'Cache-Control': 'no-cache' }
        });
        
        if (response.ok) {
            const newConfig = await response.json();
            if (newConfig && newConfig.categories) {
                const newHash = JSON.stringify({
                    categories: newConfig.categories,
                    sounds: newConfig.sounds,
                    music: newConfig.music
                });
                
                if (newHash !== lastConfigHash) {
                    console.log('🔄 Обнаружены изменения! Показываем уведомление');
                    lastConfigHash = newHash;
                    window._pendingConfig = newConfig;
                    showUpdateNotificationWithButton();
                }
            }
        }
    } catch (e) {}
}

function initSSE() {
    if (typeof EventSource === 'undefined') {
        console.log('⚠️ SSE не поддерживается, используем polling');
        startPolling();
        return;
    }
    
    try {
        if (sseConnection) {
            sseConnection.close();
        }
        
        sseConnection = new EventSource('sse.php');
        isSSEConnected = true;
        
        sseConnection.addEventListener('update', function(event) {
            console.log('🔄 SSE: Конфигурация обновлена!');
            try {
                const data = JSON.parse(event.data);
                if (data && data.hash) {
                    loadConfigFromServer().then(() => {
                        lastConfigHash = getConfigHash();
                        showUpdateNotificationWithButton();
                        window._pendingConfig = config;
                    });
                }
            } catch (e) {
                console.error('Ошибка обработки SSE события:', e);
            }
        });
        
        sseConnection.onerror = function(error) {
            console.log('⚠️ SSE ошибка, переключаемся на polling:', error);
            if (sseConnection) {
                sseConnection.close();
                sseConnection = null;
            }
            isSSEConnected = false;
            startPolling();
        };
        
        console.log('📡 SSE подключено для автоматических обновлений');
    } catch (e) {
        console.log('⚠️ SSE не доступно, используем polling');
        startPolling();
    }
}

function startPolling() {
    lastConfigHash = getConfigHash();
    
    if (autoUpdateTimer) {
        clearInterval(autoUpdateTimer);
    }
    autoUpdateTimer = setInterval(checkForUpdatesWithNotification, 30000);
    console.log('🔄 Проверка обновлений запущена (раз в 30 сек)');
}

function stopAutoUpdate() {
    if (autoUpdateTimer) {
        clearInterval(autoUpdateTimer);
        autoUpdateTimer = null;
        console.log('⏹ Polling остановлен');
    }
    if (sseConnection) {
        sseConnection.close();
        sseConnection = null;
        isSSEConnected = false;
        console.log('⏹ SSE отключено');
    }
}

function startAutoUpdate() {
    // Не держим постоянный PHP-процесс через SSE: на shared-хостинге несколько
    // открытых вкладок исчерпывают пул воркеров, после чего конфиг и MP3 ждут
    // своей очереди. Редкий короткий запрос намного дешевле и стабильнее.
    startPolling();
}

