            [...category.items].sort((a, b) => {
                const orderA = a.order !== undefined ? a.order : 999;
                const orderB = b.order !== undefined ? b.order : 999;
                return orderA - orderB;
            }) : [];
        
        if (sortedItems.length) {
            sortedItems.forEach((sound, index) => {
                const soundId = `${catKey}-${index}`;
                
                const card = document.createElement('div');
                card.className = 'sound-card';
                card.id = `card-${soundId}`;
                
                const currentCat = config.categories.find(c => c.id === currentCategory);
                const cardBg = sound.bgImage || (currentCat && currentCat.bgImage) || '';
                
                let initialVolume = savedVolumes[soundId] || 50;
                const loopEnabledCat = category && category.loop !== undefined ? category.loop : true;
                card.dataset.loop = loopEnabledCat ? 'true' : 'false';
                
                audioObjects[soundId] = { 
                    audio: null, 
                    playing: false, 
                    volume: initialVolume,
                    loaded: false,
                    file: sound.file,
                    loop: loopEnabledCat,
                    categoryKey: catKey
                };
                
                const isFav = favorites.includes(soundId);
                card.innerHTML = `
                    <div class="sound-card-bg">${cardBg ? `<img data-src="${escapeHtml(cardBg)}" alt="" loading="lazy" decoding="async">` : ''}</div>
                    <div class="sound-card-overlay"></div>
                    <button class="sound-card-fav-btn${isFav ? ' active' : ''}" id="fav-${soundId}" title="${isFav ? 'Убрать из избранного' : 'В избранное'}">${isFav ? '★' : '☆'}</button>
                    <span class="sound-card-loop-badge" title="${loopEnabledCat ? 'Автоповтор включён' : 'Однократное воспроизведение'}">${loopEnabledCat ? '↻' : '1×'}</span>
                    <div class="sound-card-content-wrapper">
                        <div class="sound-card-content">
                            <div class="sound-card-name">${escapeHtml(sound.name)}</div>
                            <button class="sound-card-play-btn" id="btn-${soundId}">▶</button>
                        </div>
                        <div class="sound-card-volume">
                            <span class="vol-icon">🔈</span>
                            <input type="range" min="0" max="100" value="${initialVolume}" id="vol-${soundId}">
                            <span class="vol-value" id="val-${soundId}">${initialVolume}%</span>
                        </div>
                    </div>
                `;
                observeLazyImages(card);

                card.addEventListener('click', function(e) {
                    if (e.target.closest('.sound-card-play-btn') || e.target.closest('.sound-card-fav-btn') || e.target.closest('input') || e.target.closest('.key-bind-btn') || e.target.closest('.key-hint')) return;
                    toggleSound(soundId);
                });

                const playBtn = card.querySelector('.sound-card-play-btn');
                playBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    toggleSound(soundId);
                });

                // На десктопе запрос начинается уже при наведении, а не после
                // клика. На touch pointerdown даёт небольшую фору до click.
                card.addEventListener('pointerenter', () => prepareSoundForPlayback(soundId), { once: true });
                card.addEventListener('pointerdown', () => prepareSoundForPlayback(soundId), { once: true });
                playBtn.addEventListener('focus', () => prepareSoundForPlayback(soundId), { once: true });

                const favBtn = card.querySelector('.sound-card-fav-btn');
                favBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    toggleFavorite(soundId);
                });
                
                const slider = card.querySelector(`#vol-${soundId}`);
                if (slider) {
                    slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${initialVolume}%, rgba(255,255,255,0.15) ${initialVolume}%, rgba(255,255,255,0.15) 100%)`;
                    slider.addEventListener('input', function(e) {
                        e.stopPropagation();
                        changeVolume(soundId, this.value);
                    });
                    slider.addEventListener('click', e => e.stopPropagation());
                }
                
                addKeyBindingButton(card, soundId);
                itemsGrid.appendChild(card);
                favoriteCardHomes[soundId] = { parent: itemsGrid };
            });
        } else {
            itemsGrid.innerHTML = '<p style="color:var(--text-secondary);padding:20px;text-align:center;grid-column:1/-1;">Нет звуков в этой категории</p>';
        }
        
        itemsWrapper.appendChild(itemsGrid);
        
        titleDiv.addEventListener('click', function() {
            catDiv.classList.toggle('collapsed');
            const cs = JSON.parse(sessionStorage.getItem('dragonSound_collapsed') || '{}');
            cs[catKey] = catDiv.classList.contains('collapsed');
            sessionStorage.setItem('dragonSound_collapsed', JSON.stringify(cs));
        });
        
        catDiv.appendChild(titleDiv);
        catDiv.appendChild(itemsWrapper);
        container.appendChild(catDiv);
        
        const cs = JSON.parse(sessionStorage.getItem('dragonSound_collapsed') || '{}');
        if (cs[catKey]) catDiv.classList.add('collapsed');
    });

    // Уже сохранённые избранные звуки сразу переносим в блок избранного
    favorites.forEach(soundId => {
        const card = document.getElementById(`card-${soundId}`);
        if (card) {
            syncSoundRepeatProperty(soundId);
            favSection.querySelector('.sound-grid').appendChild(card);
        }
    });
    updateFavoritesSectionVisibility();

    renderKeyBindingsUI();
    
    setTimeout(() => {
        loadSoundVolumes();
    }, 100);
    
    setTimeout(lazyLoadSounds, 300);
}

