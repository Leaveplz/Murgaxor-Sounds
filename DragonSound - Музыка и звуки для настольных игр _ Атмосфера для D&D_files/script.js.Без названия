// Экранирование данных из config_data.json перед вставкой в innerHTML/атрибуты
// (config.php сохраняет их без валидации, значит это untrusted-контент для рендера)
function escapeHtml(text) {
    if (text === undefined || text === null) return '';
    return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

