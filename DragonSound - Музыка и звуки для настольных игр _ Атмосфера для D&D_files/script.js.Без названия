}

// ============ КАТЕГОРИИ ЛОКАЦИЙ ============
function renderCategories() {
    const grid = document.getElementById('categoriesGrid');
    if (!config.categories.length) {
        grid.innerHTML = '<span style="color: var(--text-secondary); grid-column: 1/-1; text-align: center;">Нет категорий.</span>';
        return;
    }
    
    const sortedCats = [...config.categories].sort((a, b) => {
        const orderA = a.order !== undefined ? a.order : 999;
        const orderB = b.order !== undefined ? b.order : 999;
        return orderA - orderB;
    });
    
    grid.innerHTML = sortedCats.map((cat) => `
        <button class="cat-btn${cat.id === currentCategory ? ' active' : ''}" data-category="${escapeHtml(cat.id)}">
            ${cat.bgImage ? `<div class="cat-bg"><img data-src="${escapeHtml(cat.bgImage)}" alt="" loading="lazy" decoding="async"></div>` : ''}
            <div class="cat-content">
                ${cat.iconType === 'image' || (cat.icon && (cat.icon.startsWith('http') || cat.icon.includes('.'))) ? `
                <span class="cat-icon">
                    <img src="${escapeHtml(cat.icon)}" class="cat-icon-img" alt="${escapeHtml(cat.name)}" loading="lazy">
                </span>` : ''}
                <span class="cat-name">${escapeHtml(cat.name)}</span>
            </div>
        </button>
    `).join('');
    observeLazyImages(grid);

    grid.querySelectorAll('.cat-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (this.dataset.category === currentCategory) return;
            grid.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentCategory = this.dataset.category;
            const cat = config.categories.find(c => c.id === currentCategory);
            const isImage = cat && (cat.iconType === 'image' || (cat.icon && (cat.icon.startsWith('http') || cat.icon.includes('.'))));
            document.getElementById('currentLocation').textContent = cat ? cat.name : currentCategory;
            applyBackground();
            pauseMusicOnSwitch();
            loadPlaylist(currentCategory);
        });
    });
}

