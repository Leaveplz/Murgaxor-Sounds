function applyUserSettings(settings) {
    if (!settings) return;
    
    console.log('🔄 Применяем настройки пользователя...');
    
    if (settings.musicHotkeys) {
        window._userHotkeys = settings.musicHotkeys;
    }

    if (Array.isArray(settings.favorites)) {
        favorites = settings.favorites;
        try { sessionStorage.setItem('dragonSound_favorites', JSON.stringify(favorites)); } catch (e) {}
    }

    if (settings.avatar) {
        updateHeaderAvatarFromSettings(settings);
    }
    
    if (settings.music_volume !== undefined) {
        musicVolume = settings.music_volume / 100;
        if (musicAudio) musicAudio.volume = musicVolume;
        const volSlider = document.getElementById('musicVolume');
        if (volSlider) {
            volSlider.value = settings.music_volume;
            const percent = settings.music_volume;
            volSlider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${percent}%, rgba(255, 255, 255, 0.15) ${percent}%, rgba(255, 255, 255, 0.15) 100%)`;
        }
        const volValue = document.getElementById('musicVolumeValue');
        if (volValue) volValue.textContent = settings.music_volume + '%';
    }
    
    if (settings.soundVolumes) {
        try {
            sessionStorage.setItem('dragonSound_soundVolumes', JSON.stringify(settings.soundVolumes));
        } catch (e) {}
        
        let appliedCount = 0;
        for (let soundId in settings.soundVolumes) {
            if (audioObjects[soundId]) {
                const vol = typeof settings.soundVolumes[soundId] === 'number' ? settings.soundVolumes[soundId] : 50;
                audioObjects[soundId].volume = Math.min(100, Math.max(0, vol));
                if (audioObjects[soundId].audio) {
                    audioObjects[soundId].audio.volume = audioObjects[soundId].volume / 100;
                }
                const slider = document.getElementById(`vol-${soundId}`);
                const display = document.getElementById(`val-${soundId}`);
                if (slider) {
                    slider.value = audioObjects[soundId].volume;
                    const percent = audioObjects[soundId].volume;
                    slider.style.background = `linear-gradient(to right, var(--accent) 0%, var(--accent) ${percent}%, rgba(255,255,255,0.15) ${percent}%, rgba(255,255,255,0.15) 100%)`;
                }
                if (display) display.textContent = audioObjects[soundId].volume + '%';
                appliedCount++;
            }
        }
    }
    
    if (settings.keyBindings) {
        for (let key in settings.keyBindings) {
            keyBindings[key] = settings.keyBindings[key];
        }
        saveKeyBindingsSession();
    }
    
    if (settings.keyVolumes) {
        for (let key in settings.keyVolumes) {
            keyVolumes[key] = settings.keyVolumes[key];
        }
        saveKeyVolumesSession();
    }
    
    renderKeyBindingsUI();
    updateAllKeyDisplays();
}

