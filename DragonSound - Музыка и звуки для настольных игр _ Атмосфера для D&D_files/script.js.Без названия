let activeMusicSource = 'local';
let externalMusicPaused = false;

function getYouTubeEmbedUrl(value) {
    try {
        const url = new URL(value);
        const host = url.hostname.replace(/^www\./, '').toLowerCase();
        if (!['youtube.com', 'm.youtube.com', 'music.youtube.com', 'youtu.be'].includes(host)) return '';
        const playlistId = url.searchParams.get('list');
        // RD/RDMM — автоматически сформированные YouTube Radio-миксы. Они
        // нередко запрещают embed videoseries, хотя само видео встраивается.
        if (playlistId && !/^RD/i.test(playlistId) && /^[\w-]+$/.test(playlistId)) {
            const embed = new URL('https://www.youtube.com/embed/videoseries');
            embed.searchParams.set('list', playlistId);
            embed.searchParams.set('enablejsapi', '1');
            if (window.location.protocol === 'http:' || window.location.protocol === 'https:') embed.searchParams.set('origin', window.location.origin);
            return embed.href;
        }
        let videoId = host === 'youtu.be' ? url.pathname.split('/').filter(Boolean)[0] : url.searchParams.get('v');
        if (!videoId && url.pathname.startsWith('/embed/')) videoId = url.pathname.split('/')[2];
        if (!videoId && (url.pathname.startsWith('/shorts/') || url.pathname.startsWith('/live/'))) videoId = url.pathname.split('/')[2];
        if (!videoId || !/^[\w-]{6,20}$/.test(videoId)) return '';
        const embed = new URL(`https://www.youtube.com/embed/${encodeURIComponent(videoId)}`);
        embed.searchParams.set('enablejsapi', '1');
        if (window.location.protocol === 'http:' || window.location.protocol === 'https:') embed.searchParams.set('origin', window.location.origin);
        return embed.href;
    } catch (error) {
        return '';
    }
}

function getVkPlaylistData(value) {
    try {
        const url = new URL(value);
        const host = url.hostname.replace(/^www\./, '').toLowerCase();
        if (!['vk.com', 'm.vk.com'].includes(host)) return null;
        const match = decodeURIComponent(url.pathname + url.search).match(/(?:playlist\/|audio_playlist)(-?\d+)_(\d+)(?:_([a-f\d]+))?/i);
        if (!match) return null;
        return { ownerId: match[1], playlistId: match[2], hash: match[3] || '', originalUrl: url.href };
    } catch (error) {
        return null;
    }
}

let vkOpenApiPromise = null;

function ensureVkOpenApi() {
    if (window.VK?.Widgets?.Playlist) return Promise.resolve(window.VK);
    if (vkOpenApiPromise) return vkOpenApiPromise;
    vkOpenApiPromise = new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-dragon-vk-openapi]');
        const script = existing || document.createElement('script');
        const timeout = setTimeout(() => reject(new Error('VK API не ответил')), 12000);
        script.onload = () => {
            clearTimeout(timeout);
            window.VK?.Widgets?.Playlist ? resolve(window.VK) : reject(new Error('Виджет плейлиста VK недоступен'));
        };
        script.onerror = () => {
            clearTimeout(timeout);
            reject(new Error('Не удалось загрузить виджет VK'));
        };
        if (!existing) {
            script.src = 'https://vk.com/js/api/openapi.js';
            script.async = true;
            script.dataset.dragonVkOpenapi = '1';
            document.head.appendChild(script);
        }
    });
    return vkOpenApiPromise;
}

async function renderVkPlaylistWidget(vk, frameBox) {
    const api = await ensureVkOpenApi();
    const elementId = `vk_playlist_${String(vk.ownerId).replace('-', 'm')}_${vk.playlistId}`;
    frameBox.innerHTML = `
        <div class="vk-widget-shell">
            <div class="vk-widget-heading"><span>VK</span><strong>Плейлист</strong></div>
            <div class="vk-playlist-widget" id="${elementId}"></div>
        </div>`;
    const widgetHost = document.getElementById(elementId);
    const availableWidth = Math.max(220, Math.floor(widgetHost?.getBoundingClientRect().width || frameBox.getBoundingClientRect().width || 320));
    const fitWidget = () => {
        const iframe = widgetHost?.querySelector('iframe');
        if (!iframe) return;
        iframe.removeAttribute('width');
        iframe.style.width = '100%';
        iframe.style.maxWidth = '100%';
        iframe.style.minWidth = '0';
        iframe.style.display = 'block';
    };
    frameBox._vkObserver?.disconnect();
    frameBox._vkObserver = new MutationObserver(fitWidget);
    frameBox._vkObserver.observe(widgetHost, { childList: true, subtree: true });
    api.Widgets.Playlist(elementId, Number(vk.ownerId), Number(vk.playlistId), vk.hash || '', { width: availableWidth });
    requestAnimationFrame(fitWidget);
}

function stopEmbeddedMusic() {
    const frame = document.querySelector('#externalPlayerFrame iframe');
    if (frame) frame.src = 'about:blank';
}

function sendYouTubeCommand(command, args = []) {
    const frame = document.querySelector('#externalPlayerFrame iframe');
    if (!frame?.contentWindow || activeMusicSource !== 'youtube') return false;
    frame.contentWindow.postMessage(JSON.stringify({ event: 'command', func: command, args }), 'https://www.youtube.com');
    return true;
}

function controlExternalMusic(action, value) {
    if (activeMusicSource === 'local') return false;
    if (activeMusicSource === 'youtube') {
        const commands = { pause: 'pauseVideo', play: 'playVideo', stop: 'stopVideo', next: 'nextVideo', previous: 'previousVideo' };
        if (action === 'volume') return sendYouTubeCommand('setVolume', [value]);
        return commands[action] ? sendYouTubeCommand(commands[action]) : false;
    }
    if (activeMusicSource === 'vk') {
        if (action === 'pause' || action === 'stop') {
            stopEmbeddedMusic();
            return true;
        }
        if (action === 'play') {
            loadExternalPlaylist(false);
            return true;
        }
    }
    return false;
}

async function loadExternalPlaylist(showErrors = true) {
    const input = document.getElementById('externalPlaylistUrl');
    const frameBox = document.getElementById('externalPlayerFrame');
    const hint = document.getElementById('externalMusicHint');
    if (!input || !frameBox || !hint || activeMusicSource === 'local') return;
    const value = input.value.trim();
    hint.classList.remove('error');
    frameBox.innerHTML = '';

    if (!value) {
        hint.textContent = activeMusicSource === 'vk'
            ? 'Вставьте публичную ссылку VK вида vk.com/music/playlist/…'
            : 'Вставьте ссылку на плейлист или видео YouTube.';
        return;
    }

    let embedUrl = '';
    if (activeMusicSource === 'youtube') {
        embedUrl = getYouTubeEmbedUrl(value);
        if (!embedUrl) {
            hint.textContent = 'Не удалось распознать ссылку YouTube.';
            hint.classList.add('error');
            return;
        }
        if (window.location.protocol === 'file:') {
            hint.textContent = 'YouTube не разрешает встроенный плеер при запуске через file://. На dragon-sound.ru ссылка откроется внутри сайта.';
            hint.classList.add('error');
            frameBox.innerHTML = `<a class="external-open-link youtube-link" href="${escapeHtml(value)}" target="_blank" rel="noopener">Посмотреть на YouTube</a>`;
            localStorage.setItem('dragonSound_youtubePlaylist', value);
            return;
        }
    } else {
        const vk = getVkPlaylistData(value);
        if (!vk) {
            hint.textContent = 'Не удалось распознать ссылку на плейлист VK.';
            hint.classList.add('error');
            return;
        }
        try {
            hint.textContent = 'Загрузка виджета VK…';
            await renderVkPlaylistWidget(vk, frameBox);
            externalMusicPaused = false;
            localStorage.setItem('dragonSound_vkPlaylist', value);
            hint.textContent = 'Плейлист VK загружен.';
        } catch (error) {
            hint.textContent = `${error.message}. Проверьте, что плейлист открыт для просмотра.`;
            hint.classList.add('error');
            frameBox.innerHTML = `<a class="external-open-link" href="${escapeHtml(vk.originalUrl)}" target="_blank" rel="noopener">Открыть плейлист VK</a>`;
        }
        return;
    }

    const iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.title = activeMusicSource === 'vk' ? 'Плейлист VK' : 'Плейлист YouTube';
    iframe.loading = 'lazy';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.allowFullscreen = true;
    frameBox.appendChild(iframe);
    externalMusicPaused = false;
    localStorage.setItem(activeMusicSource === 'vk' ? 'dragonSound_vkPlaylist' : 'dragonSound_youtubePlaylist', value);
    hint.textContent = activeMusicSource === 'vk' ? 'Публичный плейлист VK загружен.' : 'Плейлист YouTube загружен.';
}

function switchMusicSource(source) {
    if (!['local', 'vk', 'youtube'].includes(source)) source = 'local';
    if (source !== activeMusicSource) stopEmbeddedMusic();
    activeMusicSource = source;
    localStorage.setItem('dragonSound_musicSource', source);
    const panel = document.querySelector('.music-panel');
    const externalPanel = document.getElementById('externalMusicPanel');
    const input = document.getElementById('externalPlaylistUrl');
    const label = document.getElementById('externalPlaylistLabel');
    document.querySelectorAll('.music-source-btn').forEach(button => button.classList.toggle('active', button.dataset.musicSource === source));
    panel?.classList.toggle('external-source', source !== 'local');
    panel?.classList.toggle('source-vk', source === 'vk');
    panel?.classList.toggle('source-youtube', source === 'youtube');
    if (externalPanel) externalPanel.hidden = source === 'local';

    if (source === 'local') return;
    pauseMusicOnSwitch();
    if (label) label.textContent = source === 'vk' ? 'Ссылка на плейлист VK' : 'Ссылка на плейлист YouTube';
    if (input) {
        input.placeholder = source === 'vk' ? 'https://vk.com/music/playlist/…' : 'https://www.youtube.com/playlist?list=…';
        input.value = localStorage.getItem(source === 'vk' ? 'dragonSound_vkPlaylist' : 'dragonSound_youtubePlaylist') || '';
    }
    loadExternalPlaylist(false);
}

function initExternalMusicSources() {
    document.querySelectorAll('.music-source-btn').forEach(button => {
        button.addEventListener('click', () => switchMusicSource(button.dataset.musicSource));
    });
    document.getElementById('loadExternalPlaylistBtn')?.addEventListener('click', () => loadExternalPlaylist(true));
    document.getElementById('externalPlaylistUrl')?.addEventListener('keydown', event => {
        if (event.key === 'Enter') loadExternalPlaylist(true);
    });
    switchMusicSource(localStorage.getItem('dragonSound_musicSource') || 'local');
}

