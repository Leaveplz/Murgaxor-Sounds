function addKeyBindingButton(card, soundId) {
    const wrapper = document.createElement('div');
    wrapper.className = 'key-bind-wrapper';
    wrapper.setAttribute('data-sound', soundId);
    
    const btn = document.createElement('button');
    btn.className = 'key-bind-btn';
    btn.setAttribute('data-sound', soundId);
    
    const keyText = document.createElement('span');
    keyText.className = 'key-text empty';
    keyText.textContent = '⋯';
    
    const tooltip = document.createElement('span');
    tooltip.className = 'key-tooltip';
    tooltip.textContent = 'Назначить клавишу';
    
    btn.appendChild(keyText);
    btn.appendChild(tooltip);
    wrapper.appendChild(btn);
    
    function updateKeyDisplay() {
        const key = Object.keys(keyBindings).find(k => keyBindings[k] === soundId);
        if (key) {
            const displayName = getKeyDisplayName(key);
            keyText.textContent = displayName.length > 3 ? displayName.substring(0, 3) : displayName;
            keyText.className = 'key-text';
            btn.classList.add('has-key');
            tooltip.textContent = `Клавиша: ${displayName} (нажмите для смены)`;
        } else {
            keyText.textContent = '⋯';
            keyText.className = 'key-text empty';
            btn.classList.remove('has-key');
            tooltip.textContent = 'Назначить клавишу';
        }
    }
    
    btn.addEventListener('click', function(e) {
        e.stopPropagation();
        window.startKeyBinding(soundId);
    });
    
    btn.addEventListener('mouseenter', function() {
        if (!btn.classList.contains('has-key')) {
            this.style.borderColor = 'rgba(255,69,0,0.3)';
        }
    });
    
    btn.addEventListener('mouseleave', function() {
        if (!btn.classList.contains('has-key')) {
            this.style.borderColor = 'rgba(255,255,255,0.12)';
        }
    });
    
    card._updateKeyDisplay = updateKeyDisplay;
    card.appendChild(wrapper);
    updateKeyDisplay();
}

